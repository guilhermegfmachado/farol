---
// A privacy-preserving "save to my toolkit" star. State lives only in the
// visitor's localStorage (see the save script in Base.astro) — nothing is sent
// anywhere. Rendered on profile and tool detail pages.
interface Props {
  type: 'profile' | 'tool';
  id: string;
  label: string;       // "Save"
  labelSaved: string;  // "Saved"
}
const { type, id, label, labelSaved } = Astro.props;
---
<button
  type="button"
  class="star-btn"
  data-save-type={type}
  data-save-id={id}
  data-label={label}
  data-label-saved={labelSaved}
  aria-pressed="false"
  aria-label={label}
  title={label}
>
  <svg class="star-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
    <path d="M12 2.6l2.85 5.98 6.55.92-4.78 4.6 1.16 6.5L12 18.9l-5.94 2.7 1.16-6.5-4.78-4.6 6.55-.92z"/>
  </svg>
  <span class="star-label">{label}</span>
</button>

<style>
.star-btn {
  display: inline-flex; align-items: center; gap: 0.35rem;
  font-family: 'JetBrains Mono', 'Mono Fallback', monospace;
  font-size: 0.68rem; letter-spacing: 0.06em; text-transform: uppercase;
  background: none; border: 1px solid var(--rule); border-radius: 999px;
  color: var(--ink-faded); padding: 0.3rem 0.7rem; cursor: pointer;
  transition: border-color 0.15s ease, color 0.15s ease, background 0.15s ease;
}
.star-btn:hover { border-color: var(--accent); color: var(--accent); }
.star-icon { fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linejoin: round; }
.star-btn[aria-pressed="true"] { color: var(--beam); border-color: var(--beam); background: var(--notice-bg); }
.star-btn[aria-pressed="true"] .star-icon { fill: var(--beam); stroke: var(--beam); }
@media print { .star-btn { display: none; } }
</style>
