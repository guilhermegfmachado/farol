---
import LighthouseMark from './LighthouseMark.astro';
import { ui, type Lang } from '@/lib/i18n';

interface Props {
  lang?: Lang;
  altHrefs?: Partial<Record<Lang, string>>;
  /** Show the site tagline under the masthead — homepages only, so content
      pages open directly on their content. */
  tagline?: boolean;
}

const { lang = 'pt', altHrefs = {}, tagline = false } = Astro.props;
const t = ui[lang];
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const allLangs: Lang[] = ['pt', 'en', 'es', 'fr', 'it', 'hr', 'de', 'nl', 'pl', 'ro', 'cs', 'sv', 'da', 'fi', 'sk', 'el', 'hu', 'bg', 'lt', 'lv', 'et', 'sl', 'ga', 'mt'];
---
<header>
  <div class="header-top">
    <span class="logotype">
      <button
        type="button"
        class="logotype-mark night-toggle"
        aria-label={t.night_toggle}
        aria-pressed="false"
        title={t.night_toggle}
      >
        <LighthouseMark />
      </button>
      <a href={lang === 'pt' ? base : `${base}${lang}/`} class="logotype-link">FAROL</a>
    </span>
    <div class="header-right">
      <div class="header-controls">
        <button
          type="button"
          class="reading-toggle"
          aria-label={t.reading_mode}
          aria-pressed="false"
          title={t.reading_mode}
        >Aa</button>
        <button
          type="button"
          class="textsize-toggle"
          aria-label={t.text_size}
          title={t.text_size}
        >A<span class="textsize-plus" aria-hidden="true">+</span></button>
        <a
          href={`${base}${lang === 'pt' ? '' : lang + '/'}toolkit/`}
          class="toolkit-link"
          aria-label={t.toolkit_nav}
          title={t.toolkit_nav}
        >
          <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="M12 2.6l2.85 5.98 6.55.92-4.78 4.6 1.16 6.5L12 18.9l-5.94 2.7 1.16-6.5-4.78-4.6 6.55-.92z"/></svg>
          <span class="toolkit-count" data-toolkit-count hidden></span>
        </a>
        <select
          class="lang-select"
          aria-label="Select language"
          onchange="if(this.value) window.location.href=this.value"
        >
          <option value="" disabled selected>{lang.toUpperCase()}</option>
          {allLangs.filter(l => l !== lang).map((l) => (
            altHrefs[l]
              ? <option value={altHrefs[l]}>{l.toUpperCase()}</option>
              : null
          ))}
        </select>
      </div>
    </div>
  </div>
  {tagline && <div class="tagline">{t.tagline}</div>}
</header>

<script is:inline>
(function() {
  var btn = document.querySelector('.night-toggle');
  if (!btn) return;
  var isDark = document.documentElement.classList.contains('dark');
  btn.setAttribute('aria-pressed', String(isDark));
  btn.addEventListener('click', function() {
    var dark = document.documentElement.classList.toggle('dark');
    btn.setAttribute('aria-pressed', String(dark));
    try { localStorage.setItem('farol-theme', dark ? 'dark' : 'light'); } catch (e) {}
  });
})();
(function() {
  var rbtn = document.querySelector('.reading-toggle');
  if (!rbtn) return;
  var isReading = document.documentElement.classList.contains('reading');
  rbtn.setAttribute('aria-pressed', String(isReading));
  rbtn.addEventListener('click', function() {
    var on = document.documentElement.classList.toggle('reading');
    rbtn.setAttribute('aria-pressed', String(on));
    try { localStorage.setItem('farol-reading', on ? '1' : '0'); } catch (e) {}
  });
})();
(function() {
  var tbtn = document.querySelector('.textsize-toggle');
  if (!tbtn) return;
  var steps = ['', 'lg', 'xl'];          // normal → large → x-large → normal
  var root = document.documentElement;
  function current() { return root.classList.contains('text-xl') ? 'xl' : root.classList.contains('text-lg') ? 'lg' : ''; }
  function apply(s) {
    root.classList.remove('text-lg', 'text-xl');
    if (s) root.classList.add('text-' + s);
    tbtn.setAttribute('aria-pressed', String(s !== ''));
    try { s ? localStorage.setItem('farol-textsize', s) : localStorage.removeItem('farol-textsize'); } catch (e) {}
  }
  tbtn.setAttribute('aria-pressed', String(current() !== ''));
  tbtn.addEventListener('click', function() {
    apply(steps[(steps.indexOf(current()) + 1) % steps.length]);
  });
})();
</script>

<style>
.night-toggle { background: none; border: none; padding: 0; cursor: pointer; color: var(--ink); transition: transform 0.2s ease; }
.night-toggle:hover { transform: scale(1.12); }
.night-toggle:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
.logotype { display: flex; align-items: center; gap: 0.35rem; }
.logotype-link {
  font-family: 'JetBrains Mono', 'Mono Fallback', monospace;
  font-size: 1.1rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: var(--ink);
  text-decoration: none;
  transition: color 0.15s ease;
}
.logotype-link:hover { color: var(--accent); }
.header-right { display: flex; flex-direction: column; align-items: flex-end; gap: 0.4rem; }
.header-controls { display: flex; align-items: center; gap: 0.6rem; }
.reading-toggle {
  font-family: 'JetBrains Mono', 'Mono Fallback', monospace;
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.02em;
  line-height: 1;
  background: var(--bg-elevated);
  border: 1px solid var(--rule);
  color: var(--ink-faded);
  min-height: 24px;
  padding: 0.3rem 0.5rem;
  cursor: pointer;
  border-radius: 2px;
  transition: border-color 0.15s ease, color 0.15s ease;
}
.reading-toggle:hover { border-color: var(--accent); color: var(--accent); }
.reading-toggle:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
.reading-toggle[aria-pressed="true"] { border-color: var(--accent); color: var(--accent); background: var(--accent-bg); }
@media print { .reading-toggle { display: none; } }
/* One compact language control at every width — the full 24-code list read as
   visual static on every page. hreflang link tags still carry the alternates. */
.lang-select {
  display: block;
  font-family: 'JetBrains Mono', 'Mono Fallback', monospace;
  font-size: 0.7rem;
  letter-spacing: 0.05em;
  background: var(--bg-elevated);
  border: 1px solid var(--rule);
  color: var(--ink-faded);
  min-height: 24px;
  padding: 0.3rem 0.5rem;
  cursor: pointer;
  border-radius: 2px;
  transition: border-color 0.15s ease, color 0.15s ease;
}
.lang-select:hover { border-color: var(--accent); color: var(--accent); }
.lang-select:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
@media (max-width: 520px) {
  /* On phones the wrapped right column shrinks to its content and sits
     mid-header; stretch it so the controls hug the right edge. */
  .header-right { width: 100%; }
}
</style>
