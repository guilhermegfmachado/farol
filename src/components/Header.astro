---
import LighthouseMark from './LighthouseMark.astro';
import { ui, type Lang } from '@/lib/i18n';

interface Props {
  lang?: Lang;
  altHrefs?: Partial<Record<Lang, string>>;
  /** Show the site tagline under the masthead — homepages only, so content
      pages open directly on their content. */
  tagline?: boolean;
}

const { lang = 'pt', altHrefs = {}, tagline = false } = Astro.props;
const t = ui[lang];
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const allLangs: Lang[] = ['pt', 'en', 'es', 'fr', 'it', 'hr', 'de', 'nl', 'pl', 'ro', 'cs', 'sv', 'da', 'fi', 'sk', 'el', 'hu', 'bg', 'lt', 'lv', 'et', 'sl', 'ga', 'mt'];
---
<header>
  <div class="header-top">
    <span class="logotype">
      <button
        type="button"
        class="logotype-mark night-toggle"
        aria-label={t.night_toggle}
        aria-pressed="false"
        title={t.night_toggle}
      >
        <LighthouseMark />
      </button>
      <a href={lang === 'pt' ? base : `${base}${lang}/`} class="logotype-link">FAROL</a>
    </span>
    <div class="header-right">
      <div class="header-controls">
        <div class="hdr-search">
          <button
            type="button"
            class="hdr-search-btn"
            aria-label={t.search_placeholder}
            aria-expanded="false"
            title={t.search_placeholder}
          >
            <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.4" y2="16.4"/></svg>
          </button>
          <input
            type="search"
            class="hdr-search-input"
            placeholder={t.search_placeholder}
            aria-label={t.search_placeholder}
            hidden
            data-search-lang={lang}
            data-search-base={base}
            data-empty={t.no_results}
          />
          <div class="hdr-search-panel" role="listbox" hidden></div>
        </div>
        <button
          type="button"
          class="reading-toggle"
          aria-label={t.reading_mode}
          aria-pressed="false"
          title={t.reading_mode}
        >Aa</button>
        <select
          class="lang-select"
          aria-label="Select language"
          onchange="if(this.value) window.location.href=this.value"
        >
          <option value="" disabled selected>{lang.toUpperCase()}</option>
          {allLangs.filter(l => l !== lang).map((l) => (
            altHrefs[l]
              ? <option value={altHrefs[l]}>{l.toUpperCase()}</option>
              : null
          ))}
        </select>
      </div>
    </div>
  </div>
  {tagline && <div class="tagline">{t.tagline}</div>}
</header>

<script is:inline>
(function() {
  var btn = document.querySelector('.night-toggle');
  if (!btn) return;
  var isDark = document.documentElement.classList.contains('dark');
  btn.setAttribute('aria-pressed', String(isDark));
  btn.addEventListener('click', function() {
    var dark = document.documentElement.classList.toggle('dark');
    btn.setAttribute('aria-pressed', String(dark));
    try { localStorage.setItem('farol-theme', dark ? 'dark' : 'light'); } catch (e) {}
  });
})();
(function() {
  var rbtn = document.querySelector('.reading-toggle');
  if (!rbtn) return;
  var isReading = document.documentElement.classList.contains('reading');
  rbtn.setAttribute('aria-pressed', String(isReading));
  rbtn.addEventListener('click', function() {
    var on = document.documentElement.classList.toggle('reading');
    rbtn.setAttribute('aria-pressed', String(on));
    try { localStorage.setItem('farol-reading', on ? '1' : '0'); } catch (e) {}
  });
})();
(function() {
  // Header full-text search: compact icon that expands to an input, with a
  // results dropdown. Per-language index fetched lazily on first keystroke.
  var wrap = document.querySelector('.hdr-search');
  if (!wrap) return;
  var btn = wrap.querySelector('.hdr-search-btn');
  var input = wrap.querySelector('.hdr-search-input');
  var panel = wrap.querySelector('.hdr-search-panel');
  var lang = input.getAttribute('data-search-lang') || 'pt';
  var idxBase = input.getAttribute('data-search-base') || '/farol/';
  var emptyMsg = input.getAttribute('data-empty') || '';
  var index = null, loading = false, pending = null;
  function open() {
    input.hidden = false;
    btn.setAttribute('aria-expanded', 'true');
    wrap.classList.add('open');
    input.focus();
  }
  function close() {
    input.hidden = true;
    panel.hidden = true;
    panel.innerHTML = '';
    input.value = '';
    btn.setAttribute('aria-expanded', 'false');
    wrap.classList.remove('open');
  }
  function ensure(cb) {
    if (index) { cb(); return; }
    pending = cb;
    if (loading) return;
    loading = true;
    fetch(idxBase + 'search/' + lang + '.json')
      .then(function (r) { return r.json(); })
      .then(function (d) { index = d; loading = false; if (pending) pending(); })
      .catch(function () { loading = false; });
  }
  function render(q) {
    var toks = q.split(/\s+/).filter(Boolean);
    var hits = index.filter(function (it) { return toks.every(function (tk) { return it.x.indexOf(tk) !== -1; }); });
    panel.innerHTML = '';
    if (!hits.length) {
      var p = document.createElement('div'); p.className = 'hdr-search-empty'; p.textContent = emptyMsg;
      panel.appendChild(p); panel.hidden = false; return;
    }
    hits.slice(0, 12).forEach(function (it) {
      var a = document.createElement('a'); a.className = 'search-result'; a.href = it.u;
      a.setAttribute('data-category', it.k || '');
      var c = document.createElement('span'); c.className = 'search-result-cat'; c.textContent = it.c;
      var t = document.createElement('span'); t.className = 'search-result-title'; t.textContent = it.t;
      var s = document.createElement('span'); s.className = 'search-result-snip'; s.textContent = it.s;
      a.appendChild(c); a.appendChild(t); if (it.s) a.appendChild(s);
      panel.appendChild(a);
    });
    panel.hidden = false;
  }
  btn.addEventListener('click', function () { input.hidden ? open() : close(); });
  input.addEventListener('input', function () {
    var q = this.value.trim().toLowerCase();
    if (q.length < 2) { panel.hidden = true; panel.innerHTML = ''; return; }
    ensure(function () { render(q); });
  });
  input.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') { close(); btn.focus(); }
    if (e.key === 'ArrowDown') {
      var first = panel.querySelector('.search-result');
      if (first) { e.preventDefault(); first.focus(); }
    }
  });
  panel.addEventListener('keydown', function (e) {
    var links = Array.prototype.slice.call(panel.querySelectorAll('.search-result'));
    var i = links.indexOf(document.activeElement);
    if (e.key === 'ArrowDown' && i < links.length - 1) { e.preventDefault(); links[i + 1].focus(); }
    if (e.key === 'ArrowUp') { e.preventDefault(); (i > 0 ? links[i - 1] : input).focus(); }
    if (e.key === 'Escape') { close(); btn.focus(); }
  });
  document.addEventListener('click', function (e) {
    if (!wrap.contains(e.target) && !input.hidden) close();
  });
})();
</script>

<style>
.night-toggle { background: none; border: none; padding: 0; cursor: pointer; color: var(--ink); transition: transform 0.2s ease; }
.night-toggle:hover { transform: scale(1.12); }
.night-toggle:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
.logotype { display: flex; align-items: center; gap: 0.35rem; }
.logotype-link {
  font-family: 'JetBrains Mono', 'Mono Fallback', monospace;
  font-size: 1.1rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: var(--ink);
  text-decoration: none;
  transition: color 0.15s ease;
}
.logotype-link:hover { color: var(--accent); }
.header-right { display: flex; flex-direction: column; align-items: flex-end; gap: 0.4rem; }
.header-controls { display: flex; align-items: center; gap: 0.6rem; }
.reading-toggle {
  font-family: 'JetBrains Mono', 'Mono Fallback', monospace;
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.02em;
  line-height: 1;
  background: var(--bg-elevated);
  border: 1px solid var(--rule);
  color: var(--ink-faded);
  min-height: 24px;
  padding: 0.3rem 0.5rem;
  cursor: pointer;
  border-radius: 2px;
  transition: border-color 0.15s ease, color 0.15s ease;
}
.reading-toggle:hover { border-color: var(--accent); color: var(--accent); }
.reading-toggle:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
.reading-toggle[aria-pressed="true"] { border-color: var(--accent); color: var(--accent); background: var(--accent-bg); }
@media print { .reading-toggle { display: none; } }
/* One compact language control at every width — the full 24-code list read as
   visual static on every page. hreflang link tags still carry the alternates. */
.lang-select {
  display: block;
  font-family: 'JetBrains Mono', 'Mono Fallback', monospace;
  font-size: 0.7rem;
  letter-spacing: 0.05em;
  background: var(--bg-elevated);
  border: 1px solid var(--rule);
  color: var(--ink-faded);
  min-height: 24px;
  padding: 0.3rem 0.5rem;
  cursor: pointer;
  border-radius: 2px;
  transition: border-color 0.15s ease, color 0.15s ease;
}
.lang-select:hover { border-color: var(--accent); color: var(--accent); }
.lang-select:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
@media (max-width: 520px) {
  /* On phones the wrapped right column shrinks to its content and sits
     mid-header; stretch it so the controls hug the right edge. */
  .header-right { width: 100%; }
}
/* Header search: icon that expands into an input, results in a dropdown. */
.hdr-search { position: relative; display: flex; align-items: center; gap: 0.4rem; }
.hdr-search-btn {
  display: inline-flex; align-items: center; justify-content: center;
  background: var(--bg-elevated); border: 1px solid var(--rule);
  color: var(--ink-faded); min-height: 24px; min-width: 26px;
  padding: 0.3rem 0.4rem; cursor: pointer; border-radius: 2px;
  transition: border-color 0.15s ease, color 0.15s ease;
}
.hdr-search-btn:hover { border-color: var(--accent); color: var(--accent); }
.hdr-search-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
.hdr-search-btn[aria-expanded="true"] { border-color: var(--accent); color: var(--accent); }
.hdr-search-input {
  font-family: 'JetBrains Mono', 'Mono Fallback', monospace;
  font-size: 0.72rem; width: 11rem; max-width: 40vw;
  background: var(--bg-elevated); border: 1px solid var(--rule);
  color: var(--ink); padding: 0.3rem 0.5rem; border-radius: 2px; outline: none;
}
.hdr-search-input:focus { border-color: var(--accent); }
.hdr-search-input::placeholder { color: var(--ink-faded); }
.hdr-search-panel {
  position: absolute; top: calc(100% + 6px); right: 0; z-index: 50;
  width: min(26rem, 88vw); max-height: 60vh; overflow-y: auto;
  background: var(--bg-elevated); border: 1px solid var(--rule);
  border-radius: 3px; box-shadow: 0 8px 28px rgba(0,0,0,0.14);
}
.hdr-search-empty {
  font-family: 'JetBrains Mono', 'Mono Fallback', monospace;
  font-size: 0.72rem; color: var(--ink-faded); padding: 0.8rem 1rem;
}
@media print { .hdr-search { display: none; } }
</style>
