---
import LighthouseMark from './LighthouseMark.astro';
import { ui, type Lang } from '@/lib/i18n';

interface Props {
  lang?: Lang;
  altHrefs?: Partial<Record<Lang, string>>;
}

const { lang = 'pt', altHrefs = {} } = Astro.props;
const t = ui[lang];
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const allLangs: Lang[] = ['pt', 'en', 'es', 'fr', 'it', 'hr', 'de', 'nl', 'pl', 'ro', 'cs', 'sv', 'da', 'fi', 'sk', 'el', 'hu', 'bg', 'lt', 'lv', 'et', 'sl', 'ga', 'mt'];
---
<header>
  <div class="header-top">
    <span class="logotype">
      <button
        type="button"
        class="logotype-mark night-toggle"
        aria-label={t.night_toggle}
        aria-pressed="false"
        title={t.night_toggle}
      >
        <LighthouseMark />
      </button>
      <a href={lang === 'pt' ? base : `${base}${lang}/`} class="logotype-link">FAROL</a>
    </span>
    <div class="header-right">
      <div class="header-controls">
        <button
          type="button"
          class="reading-toggle"
          aria-label={t.reading_mode}
          aria-pressed="false"
          title={t.reading_mode}
        >Aa</button>
        <div class="version-tag">{t.version_tag}</div>
      </div>
      <div class="lang-switcher" aria-label="Select language">
        {allLangs.map((l) => (
          <>
            {l === lang
              ? <span class="lang-current">{l.toUpperCase()}</span>
              : altHrefs[l]
                ? <a href={altHrefs[l]} class="lang-link">{l.toUpperCase()}</a>
                : <span class="lang-unavail">{l.toUpperCase()}</span>
            }
          </>
        ))}
      </div>
      <select
        class="lang-select"
        aria-label="Select language"
        onchange="if(this.value) window.location.href=this.value"
      >
        <option value="" disabled selected>{lang.toUpperCase()}</option>
        {allLangs.filter(l => l !== lang).map((l) => (
          altHrefs[l]
            ? <option value={altHrefs[l]}>{l.toUpperCase()}</option>
            : null
        ))}
      </select>
    </div>
  </div>
  <div class="tagline">{t.tagline}</div>
</header>

<script is:inline>
(function() {
  var btn = document.querySelector('.night-toggle');
  if (!btn) return;
  var isDark = document.documentElement.classList.contains('dark');
  btn.setAttribute('aria-pressed', String(isDark));
  btn.addEventListener('click', function() {
    var dark = document.documentElement.classList.toggle('dark');
    btn.setAttribute('aria-pressed', String(dark));
    try { localStorage.setItem('farol-theme', dark ? 'dark' : 'light'); } catch (e) {}
  });
})();
(function() {
  var rbtn = document.querySelector('.reading-toggle');
  if (!rbtn) return;
  var isReading = document.documentElement.classList.contains('reading');
  rbtn.setAttribute('aria-pressed', String(isReading));
  rbtn.addEventListener('click', function() {
    var on = document.documentElement.classList.toggle('reading');
    rbtn.setAttribute('aria-pressed', String(on));
    try { localStorage.setItem('farol-reading', on ? '1' : '0'); } catch (e) {}
  });
})();
</script>

<style>
.night-toggle { background: none; border: none; padding: 0; cursor: pointer; color: var(--ink); transition: transform 0.2s ease; }
.night-toggle:hover { transform: scale(1.12); }
.night-toggle:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
.logotype { display: flex; align-items: center; gap: 0.35rem; }
.logotype-link {
  font-family: 'JetBrains Mono', monospace;
  font-size: 1.1rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: var(--ink);
  text-decoration: none;
  transition: color 0.15s ease;
}
.logotype-link:hover { color: var(--accent); }
.header-right { display: flex; flex-direction: column; align-items: flex-end; gap: 0.4rem; }
.header-controls { display: flex; align-items: center; gap: 0.6rem; }
.reading-toggle {
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.02em;
  line-height: 1;
  background: var(--bg-elevated);
  border: 1px solid var(--rule);
  color: var(--ink-faded);
  min-height: 24px;
  padding: 0.3rem 0.5rem;
  cursor: pointer;
  border-radius: 2px;
  transition: border-color 0.15s ease, color 0.15s ease;
}
.reading-toggle:hover { border-color: var(--accent); color: var(--accent); }
.reading-toggle:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
.reading-toggle[aria-pressed="true"] { border-color: var(--accent); color: var(--accent); background: var(--accent-bg); }
@media print { .reading-toggle { display: none; } }
.lang-switcher { display: flex; flex-wrap: wrap; align-items: center; gap: 0.1rem 0.15rem; font-family: 'JetBrains Mono', monospace; font-size: 0.65rem; letter-spacing: 0.08em; max-width: 19rem; }
.lang-current, .lang-link, .lang-unavail { display: inline-block; padding: 0.3rem 0.28rem; line-height: 1; }
.lang-current { color: var(--ink); font-weight: 700; }
.lang-link { color: var(--ink-faded); text-decoration: none; transition: color 0.15s ease; }
.lang-link:hover { color: var(--accent); }
.lang-unavail { color: var(--rule-strong); }
.lang-select { display: none; }
@media (max-width: 520px) {
  .lang-switcher { display: none; }
  .lang-select {
    display: block;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    background: var(--bg-elevated);
    border: 1px solid var(--rule);
    color: var(--ink-faded);
    padding: 0.3rem 0.5rem;
    cursor: pointer;
    border-radius: 2px;
  }
}
</style>
