<svg width="100%" height="100%" viewBox="0 0 26 26" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <!-- Bottom-heavy banded tower: the taper, the overhanging gallery and the
       stripe gaps are what make this read as a lighthouse rather than a plain
       column, and they survive down to 14px. -->
  <path d="M10.3 6.2 L13 3.3 L15.7 6.2 Z" fill="currentColor"/>
  <rect x="10.9" y="6.2" width="4.2" height="3.5" fill="currentColor"/>
  <rect x="8.7" y="9.7" width="8.6" height="1.4" fill="currentColor"/>
  <path d="M10.4 11.1 L15.6 11.1 L15.95 13.0 L10.05 13.0 Z" fill="currentColor"/>
  <path d="M9.87 13.9 L16.13 13.9 L16.45 16.6 L9.55 16.6 Z" fill="currentColor"/>
  <path d="M9.35 17.5 L16.65 17.5 L17.5 21.3 L8.5 21.3 Z" fill="currentColor"/>
  <rect x="7.1" y="21.3" width="11.8" height="2" fill="currentColor"/>
  <g class="mark-rays">
    <path d="M10.2 7.9 L2.4 4.6 L2.4 11.2 Z" fill="#e8a93d" opacity="0.45"/>
    <path d="M15.8 7.9 L23.6 4.6 L23.6 11.2 Z" fill="#e8a93d" opacity="0.45"/>
  </g>
  <circle class="mark-beam" cx="13" cy="7.9" r="1.45"/>
</svg>

<style>
/* Daytime: beacon off. Night: lit amber with a soft glow and side beams. */
.mark-beam { fill: var(--ink-faded); transition: fill 0.35s ease, filter 0.35s ease; }
.mark-rays { opacity: 0; transition: opacity 0.35s ease; }
:global(html.dark) .mark-beam { fill: #e8a93d; filter: drop-shadow(0 0 3px #e8a93d); }
:global(html.dark) .mark-rays { opacity: 1; }
@media (prefers-reduced-motion: no-preference) {
  :global(html.dark) .mark-beam { animation: mark-pulse 3s ease-in-out infinite; }
}
@keyframes mark-pulse {
  0%, 100% { filter: drop-shadow(0 0 2px #e8a93d); }
  50% { filter: drop-shadow(0 0 5px #e8a93d); }
}
</style>
