<svg width="100%" height="100%" viewBox="0 0 26 26" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
  <rect x="10" y="9" width="6" height="14" fill="currentColor"/>
  <rect x="8" y="22" width="10" height="2" fill="currentColor"/>
  <rect x="9" y="6" width="8" height="3" fill="currentColor"/>
  <path d="M9 6 L13 3 L17 6 Z" fill="currentColor"/>
  <g class="mark-rays">
    <path d="M9.5 7.5 L3 4.5 L3 10.5 Z" fill="#e8a93d" opacity="0.45"/>
    <path d="M16.5 7.5 L23 4.5 L23 10.5 Z" fill="#e8a93d" opacity="0.45"/>
  </g>
  <circle class="mark-beam" cx="13" cy="7.5" r="1.5"/>
</svg>

<style>
/* Daytime: beacon off. Night: lit amber with a soft glow and side beams. */
.mark-beam { fill: var(--ink-faded); transition: fill 0.35s ease, filter 0.35s ease; }
.mark-rays { opacity: 0; transition: opacity 0.35s ease; }
:global(html.dark) .mark-beam { fill: #e8a93d; filter: drop-shadow(0 0 3px #e8a93d); }
:global(html.dark) .mark-rays { opacity: 1; }
@media (prefers-reduced-motion: no-preference) {
  :global(html.dark) .mark-beam { animation: mark-pulse 3s ease-in-out infinite; }
}
@keyframes mark-pulse {
  0%, 100% { filter: drop-shadow(0 0 2px #e8a93d); }
  50% { filter: drop-shadow(0 0 5px #e8a93d); }
}
</style>
