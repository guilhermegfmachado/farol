---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<footer>
  <div>Farol · Manual de docente</div>
  <div><a href={`${base}sobre/`}>Como usar</a> · Recurso aberto · CC BY-NC-SA</div>
  <div>Conceito por <a href="https://guilhermegfmachado.github.io/work/" target="_blank" rel="noopener noreferrer">Guilherme de Góis Machado</a></div>
</footer>

<style>
footer a { color: var(--ink-faded); text-decoration: none; border-bottom: 1px solid var(--rule); transition: color 0.15s ease; }
footer a:hover { color: var(--accent); }
</style>
