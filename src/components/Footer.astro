---
import { ui, allAboutHrefs, type Lang } from '@/lib/i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'pt' } = Astro.props;
const t = ui[lang];
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const sobreHref = allAboutHrefs(base)[lang];
---
<footer>
  <div>{t.footer_manual}</div>
  <div><a href={sobreHref}>{t.footer_how}</a> · {t.footer_licence}</div>
  <div>{t.footer_by} <a href="https://guilhermegfmachado.github.io/work/" target="_blank" rel="noopener noreferrer">Guilherme de Góis Machado</a></div>
  <div class="footer-feedback"><a href="https://github.com/guilhermegfmachado/farol/issues/new?template=correction.md" target="_blank" rel="noopener noreferrer">{t.feedback_link}</a></div>
</footer>

<style>
footer { margin-top: 2rem; padding-top: 1rem; border-top: 1px solid var(--rule); }
footer a { color: var(--ink-faded); text-decoration: none; border-bottom: 1px solid var(--rule); transition: color 0.15s ease; }
footer a:hover { color: var(--accent); }
.footer-feedback { margin-top: 0.5rem; }
.footer-feedback a { font-family: 'JetBrains Mono', 'Mono Fallback', monospace; font-size: 0.68rem; letter-spacing: 0.05em; }
</style>
