---
// One homepage for the 28 prefixed locales. Portuguese lives at the site root
// (src/pages/index.astro) and shares this shape.
import { ui, allIndexHrefs, PREFIXED_LANGS, type Lang } from '@/lib/i18n';
import { observations, obsThemes, obsText } from '@/lib/observations';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Tower from '../../components/Tower.astro';

export function getStaticPaths() {
  return PREFIXED_LANGS.map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props as { lang: Lang };
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const t = ui[lang];
const home = `${base}${lang}/`;
---
<Base title={t.home_title} description={t.tagline} altHrefs={allIndexHrefs(base)}>
  <Header lang={lang} altHrefs={allIndexHrefs(base)} tagline />

  <div class="intro">
    <div class="intro-label">{t.about_label}</div>
    <div class="intro-body">
      <p>{t.about_p1}</p>
      <a class="intro-more" href={`${home}about/`}>{t.about_more} →</a>
    </div>
  </div>

  <div class="home-scene">
    <div class="home-sun" aria-hidden="true"></div>
    <div class="home-split">
    <section class="observe">
      <div class="observe-head">
        <div class="observe-label">{t.observe_label}</div>
        <p class="observe-hint">{t.observe_hint}</p>
      </div>
      {obsThemes.map((th) => (
        <div class="observe-group">
          <div class="observe-theme">{th.label[lang]}</div>
          <div class="observe-grid">
            {observations.filter((o) => th.profiles.includes(o.profile)).map((o) => (
              <a class="observe-chip" href={`${home}profiles/${o.profile}/`}>
                <span class="observe-chip-text">{obsText(o, lang)}</span>
                <span class="observe-chip-arrow" aria-hidden="true">→</span>
              </a>
            ))}
          </div>
        </div>
      ))}
    </section>

    <div class="home-tower">
      <div class="home-tower-label">{t.lh_title}</div>
        <Tower lang={lang} label={t.lh_title} variant="bare" />
      </div>
    </div>
    <div class="home-shore" aria-hidden="true"></div>
  </div>
  <nav class="browse-links" aria-label={t.home_nav_label}>
    <a href={`${home}profiles/`}>{t.browse_profiles}</a>
    <a href={`${home}references/`}>{t.browse_refs}</a>
  </nav>

  <a href={`${home}tools/`} class="tools-link">
    <span class="tools-link-label">{t.tools_catalog}</span>
    <span class="tools-link-title">{t.tools_title}</span>
    <span class="tools-link-desc">{t.tools_desc}</span>
  </a>

  <Footer lang={lang} />
</Base>

<style>
/* One scene, not a picture beside text. The paper field, the sun behind the
   heading and the sea along the foot belong to the whole section; the tower
   stands in it on the right. Above 900px the observations take the left half —
   which they already only used — and below it they stack, observations first,
   because they are the way in. */
.home-scene { --paper: #ede4d0; --sea: #3a7370; position: relative; overflow: hidden; background: var(--paper); border: 1px solid var(--rule); padding: 2rem 2rem 0; }
:global(html.dark) .home-scene { --paper: #171c2a; --sea: #28524f; }
/* The observation rules are drawn for the page background; on the paper they
   all but vanish, so inside the scene they are ink at low opacity instead. */
.home-scene :global(.observe-chip) { border-left-color: rgba(20, 23, 26, 0.16); }
:global(html.dark) .home-scene :global(.observe-chip) { border-left-color: rgba(236, 231, 220, 0.18); }
.home-sun { position: absolute; top: -110px; left: -70px; width: 300px; height: 300px; border-radius: 50%; background: #d9a13b; opacity: 0.14; pointer-events: none; }
.home-split { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 2.5rem; align-items: start; }
/* The tower stands on the shore: bottom-aligned so its plinth meets the sea,
   with the sky above it rather than a gap below. */
.home-tower { align-self: end; }
.home-tower-label { font-family: 'JetBrains Mono', 'Mono Fallback', monospace; font-size: 0.7rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--ink-faded); margin-bottom: 0.6rem; }
.home-shore { position: relative; z-index: 0; height: 56px; margin: 0 -2rem; background: var(--sea); }
@media (max-width: 900px) {
  .home-scene { padding: 1.5rem 1.25rem 0; }
  .home-split { grid-template-columns: 1fr; gap: 2rem; }
  /* Stacked, the tower is a figure in a full-width block rather than a column
     of its own — at 768px it was sitting 161px left of centre. */
  .home-tower { max-width: 340px; margin-inline: auto; }
  .home-tower-label { text-align: center; }
  .home-shore { height: 40px; margin: 1.25rem -1.25rem 0; }
}
/* Solid dark ink is a waste of toner. */
@media print { .home-scene { background: none; border: none; padding: 0; } .home-tower, .home-sun, .home-shore { display: none; } }
.browse-links { display: flex; flex-wrap: wrap; gap: 1.6rem; margin: 2rem 0; }
.browse-links a { font-family: 'JetBrains Mono', 'Mono Fallback', monospace; font-size: 0.78rem; letter-spacing: 0.04em; color: var(--ink-soft); text-decoration: none; border-bottom: 1px solid var(--rule); padding-bottom: 0.15rem; transition: color 0.15s ease, border-color 0.15s ease; }
.browse-links a:hover { color: var(--accent); border-color: var(--accent); }
.tools-link-lighthouse { border-left-color: var(--accent); }
.tools-link-lighthouse:hover { border-color: var(--accent); }
.tools-link { display: flex; flex-direction: column; gap: 0.3rem; padding: 1.2rem 1.5rem; background: var(--bg-elevated); border: 1px solid var(--rule); border-left: 3px solid var(--beam); text-decoration: none; transition: border-color 0.2s ease; }
.tools-link:hover { border-color: var(--beam); box-shadow: 0 2px 12px rgba(20,23,26,0.05); }
.tools-link-label { font-family: 'JetBrains Mono', 'Mono Fallback', monospace; font-size: 0.65rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-faded); }
.tools-link-title { font-size: 1rem; font-weight: 600; color: var(--ink); }
.tools-link-desc { font-size: 0.85rem; color: var(--ink-soft); }
</style>
