---
// Profile index. The card grid that used to sit on the homepage beneath the
// observation list, competing with it for the same seven destinations.
import { getAllEntries, displayIndex } from '@/lib/entries';
import { ui, entryTranslations, categoryTranslations, allSectionHrefs, PREFIXED_LANGS, type Lang } from '@/lib/i18n';
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';

export function getStaticPaths() {
  return PREFIXED_LANGS.map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props as { lang: Lang };
const entries = (await getAllEntries()).filter((e) => e.data.category === 'Perfil');
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const t = ui[lang];
const cat = categoryTranslations[lang] ?? {};
const home = `${base}${lang}/`;
const hrefs = allSectionHrefs(base, 'profiles');
---
<Base title={`${t.home_profiles} — Farol`} description={t.tagline} altHrefs={hrefs}>
  <Header lang={lang} altHrefs={hrefs} />
  <Breadcrumb crumbs={[{ label: t.breadcrumb_home, href: home }, { label: t.home_profiles.toLowerCase() }]} />
  <div class="prompt-section">
    <h1 class="prompt-question">{t.home_profiles}</h1>
  </div>
  <nav class="tree" aria-label={t.home_profiles}>
    {entries.map((entry) => {
      const slug = entry.id.replace(/\.md$/, '');
      const tr = entryTranslations[lang]?.[slug];
      return (
        <a href={`${home}${entry.collection}/${slug}/`} class="tree-node animate-in" data-category={entry.data.category}>
          <span class="tree-node-category">{cat[entry.data.category] ?? entry.data.category}</span>
          <span class="tree-node-index" aria-hidden="true">{displayIndex(entry.data)}</span>
          <span class="tree-node-title">{tr?.title ?? entry.data.title}</span>
          <span class="tree-node-desc">{tr?.desc ?? entry.data.desc}</span>
          <span class="tree-node-arrow">{t.consult} <span aria-hidden="true">→</span></span>
        </a>
      );
    })}
  </nav>
  <Footer lang={lang} />
</Base>
<style>
.tree-node[data-category="Perfil"] { border-left: 3px solid var(--accent); }
</style>
