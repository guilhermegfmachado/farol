---
import { ui, entryTranslations, type Lang, PREFIXED_LANGS } from '@/lib/i18n';
import { made, allMadeHrefs } from '@/lib/made';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

export function getStaticPaths() {
  const langs: Lang[] = PREFIXED_LANGS;
  return langs.map((lang) => ({ params: { lang }, props: { lang } }));
}

const { lang } = Astro.props as { lang: Lang };
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const t = ui[lang];
const m = made[lang];
const eticaTitle = entryTranslations[lang]?.etica?.title ?? 'Ética & RGPD';
---
<Base
  title={`${m.title} — Farol`}
  description={m.desc}
  altHrefs={allMadeHrefs(base)}
>
  <Header lang={lang} altHrefs={allMadeHrefs(base)} />

  <Breadcrumb crumbs={[
    { label: t.breadcrumb_home, href: `${base}${lang}/` },
    { label: m.title.toLowerCase() },
  ]} />

  <article class="card animate-in">
    <header class="card-header">
      <div class="card-header-meta">
        <span class="card-category">{m.cat}</span>
      </div>
      <h1 class="card-title">{m.title}</h1>
      <p class="card-subtitle">{m.subtitle}</p>
    </header>

    <section class="card-section">
      <ul>
        {m.items.map((item) => <li><span set:html={item} /></li>)}
      </ul>
      <a class="section-ref-link" href={`${base}${lang}/references/etica/`}>{m.etica}: {eticaTitle} →</a>
    </section>
  </article>

  <Footer lang={lang} />
</Base>

<style>
.section-ref-link { display: inline-block; margin-top: 0.9rem; font-family: 'JetBrains Mono', 'Mono Fallback', monospace; font-size: 0.7rem; letter-spacing: 0.04em; color: var(--accent); text-decoration: none; border-bottom: 1px solid var(--rule); padding-bottom: 0.1rem; transition: border-color 0.15s ease; }
.section-ref-link:hover { border-color: var(--accent); }
</style>
