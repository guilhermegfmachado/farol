---
import { getCollection } from 'astro:content';
import { ui, entryTranslations, type Lang, allLangHrefs } from '@/lib/i18n';
import { toolTranslations } from '@/lib/tool-translations';
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import SaveStar from '../../../components/SaveStar.astro';

export async function getStaticPaths() {
  const langs: Lang[] = ['en','es','fr','it','hr','de','nl','pl','ro','cs','sv','da','fi','sk','el','hu','bg','lt','lv','et','sl','ga','mt'];
  const tools = await getCollection('tools');
  return langs.flatMap((lang) =>
    tools.map((tool) => ({
      params: { lang, slug: tool.id.replace(/\.md$/, '') },
      props: { tool, lang },
    }))
  );
}

const { tool, lang } = Astro.props as { tool: any; lang: Lang };
const { name, url, profiles, free } = tool.data;
const slug = tool.id.replace(/\.md$/, '');
const tTool = toolTranslations[lang]?.[slug];
const desc = tTool?.desc ?? tool.data.desc;
const rgpd_note = tTool?.rgpd_note ?? tool.data.rgpd_note;
const t = ui[lang];
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base title={`${name} — ${t.breadcrumb_tools} — Farol`} description={desc} altHrefs={allLangHrefs(base, 'tools', slug)}>
  <Header lang={lang} altHrefs={allLangHrefs(base, 'tools', slug)} />

  <Breadcrumb crumbs={[
    { label: t.breadcrumb_home, href: `${base}${lang}/` },
    { label: t.breadcrumb_tools, href: `${base}${lang}/tools/` },
    { label: name.toLowerCase() },
  ]} />

  <article class="card animate-in">
    <header class="card-header">
      <h1 class="card-title">{name}</h1>
      {url && (
        <p class="card-subtitle">
          <a href={url} target="_blank" rel="noopener noreferrer" class="tool-url">{url.replace(/^https?:\/\//, '')}</a>
        </p>
      )}
    <div class="card-actions"><SaveStar type="tool" id={slug} label={t.save_add} labelSaved={t.save_remove} /></div>
    </header>

    <section class="card-section">
      <h2 class="card-section-label">{t.tool_desc_label}</h2>
      <p class="tool-desc">{desc}</p>
    </section>

    {profiles.length > 0 && (
      <section class="card-section">
        <h2 class="card-section-label">{t.tool_profiles_label}</h2>
        <div class="tool-profiles">
          {profiles.map((slug: string) => (
            <a href={`${base}${lang}/profiles/${slug}/`} class="tool-profile-tag">{entryTranslations[lang]?.[slug]?.title ?? slug}</a>
          ))}
        </div>
      </section>
    )}

    {free !== undefined && (
      <section class="card-section">
        <h2 class="card-section-label">{t.tool_access_label}</h2>
        <p class="tool-desc">{free ? t.tool_free : t.tool_paid}</p>
      </section>
    )}

    {rgpd_note && (
      <section class="card-section">
        <h2 class="card-section-label">{t.tool_privacy_label}</h2>
        <p class="tool-desc">{rgpd_note}</p>
      </section>
    )}
  </article>

  <div class="card-nav-back">
    <a href={`${base}${lang}/tools/`} class="card-nav-item">
      <span class="card-nav-dir">{t.nav_back_tools}</span>
      <span class="card-nav-title">{t.nav_all_tools}</span>
    </a>
  </div>

  <Footer lang={lang} />
</Base>

<style>
.tool-desc { color: var(--ink-soft); font-size: 0.95rem; line-height: 1.7; }
.tool-url { color: var(--accent); text-decoration: none; font-family: 'JetBrains Mono', 'Mono Fallback', monospace; font-size: 0.85rem; }
.tool-url:hover { text-decoration: underline; }
.tool-profiles { display: flex; gap: 0.5rem; flex-wrap: wrap; }
.tool-profile-tag { font-family: 'JetBrains Mono', 'Mono Fallback', monospace; font-size: 0.75rem; color: var(--accent); border: 1px solid var(--accent); padding: 0.2rem 0.6rem; text-decoration: none; letter-spacing: 0.03em; transition: background 0.15s ease; }
.tool-profile-tag:hover { background: var(--accent-bg); }
.card-nav-back { margin-top: 2rem; }
.card-nav-item { display: inline-flex; flex-direction: column; gap: 0.2rem; padding: 0.9rem 1.2rem; border: 1px solid var(--rule); background: var(--bg-elevated); text-decoration: none; transition: border-color 0.15s ease; }
.card-nav-item:hover { border-color: var(--accent); }
.card-nav-dir { font-family: 'JetBrains Mono', 'Mono Fallback', monospace; font-size: 0.65rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-faded); }
.card-nav-title { font-size: 0.95rem; font-weight: 600; color: var(--ink); }
</style>
