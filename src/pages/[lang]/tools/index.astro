---
import { getCollection } from 'astro:content';
import { ui, type Lang, allSectionHrefs } from '@/lib/i18n';
import { toolTranslations } from '@/lib/tool-translations';
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';

export function getStaticPaths() {
  const langs: Lang[] = ['en','es','fr','it','hr','de','nl','pl','ro','cs','sv','da','fi','sk','el','hu','bg','lt','lv','et','sl','ga','mt'];
  return langs.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = ui[lang];
const tools = await getCollection('tools');
tools.sort((a, b) => a.data.name.localeCompare(b.data.name, 'en'));
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base
  title={`${t.tools_question} — Farol`}
  description={t.tools_desc}
  altHrefs={allSectionHrefs(base, 'tools')}
>
  <Header lang={lang} altHrefs={allSectionHrefs(base, 'tools')} />

  <Breadcrumb crumbs={[
    { label: t.breadcrumb_home, href: `${base}${lang}/` },
    { label: t.breadcrumb_tools },
  ]} />

  <div class="prompt-section">
    <div class="prompt-label">{t.tools_catalog}</div>
    <div class="prompt-question">{t.tools_question}</div>
  </div>

  <div class="search-bar"><input id="card-search" type="search" class="search-input" placeholder={t.tools_search_placeholder} aria-label={t.tools_search_placeholder} /></div>
  <nav class="tree" aria-label={t.breadcrumb_tools}>
    {tools.map((tool) => (
      <a
        href={`${base}${lang}/tools/${tool.id.replace(/\.md$/, '')}/`}
        class="tree-node animate-in"
        data-category="tool"
      >
        <span class="tree-node-title">{tool.data.name}</span>
        <span class="tree-node-desc">{toolTranslations[lang]?.[tool.id.replace(/\.md$/, '')]?.desc ?? tool.data.desc}</span>
        {tool.data.free !== undefined && (
          <span class="tree-node-index" style="font-size:0.7rem">{tool.data.free ? t.tool_free : t.tool_paid}</span>
        )}
        <span class="tree-node-arrow">{t.tool_view} <span aria-hidden="true">→</span></span>
      </a>
    ))}
  </nav>
  <p class="search-empty" id="search-empty" hidden>{t.no_results}</p>

  <Footer lang={lang} />
</Base>

<script is:inline>
(function() {
  var input = document.getElementById('card-search');
  var nodes = document.querySelectorAll('.tree-node');
  var empty = document.getElementById('search-empty');
  if (!input || !nodes.length) return;
  input.addEventListener('input', function() {
    var q = this.value.trim().toLowerCase();
    var shown = 0;
    nodes.forEach(function(node) {
      var match = !q || node.textContent.toLowerCase().includes(q);
      node.style.display = match ? '' : 'none';
      if (match) shown++;
    });
    if (empty) empty.hidden = shown !== 0;
  });
})();
</script>

<style>
.tree-node[data-category="tool"] { border-left: 3px solid var(--beam); }
.search-bar { margin-bottom: 0.75rem; }
.search-input { width: 100%; box-sizing: border-box; font-family: 'JetBrains Mono', 'Mono Fallback', monospace; font-size: 0.8rem; padding: 0.55rem 0.9rem; border: 1px solid var(--rule); background: var(--bg-elevated); color: var(--ink); outline: none; transition: border-color 0.15s ease; }
.search-input:focus { border-color: var(--accent); }
.search-input::placeholder { color: var(--ink-faded); }
.search-empty { margin: 1rem 0; padding: 0.9rem 1rem; font-family: 'JetBrains Mono', 'Mono Fallback', monospace; font-size: 0.78rem; color: var(--ink-faded); border: 1px dashed var(--rule); text-align: center; }
</style>
