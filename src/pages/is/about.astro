---
import { ui, allAboutHrefs } from '@/lib/i18n';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const t = ui['is'];
---
<Base title="Um — Farol" description="Hvað Farol er, hvernig hún er notuð og hvers má vænta af gervigreindarhlutunum." altHrefs={allAboutHrefs(base)}>
  <Header lang="is" altHrefs={allAboutHrefs(base)} />
  <Breadcrumb crumbs={[{ label: t.breadcrumb_home, href: `${base}is/` }, { label: t.breadcrumb_about }]} />
  <article class="card animate-in">
    <header class="card-header">
      <div class="card-header-meta"><span class="card-category">Leiðbeiningar</span></div>
      <h1 class="card-title">Hvernig á að nota Farol</h1>
      <p class="card-subtitle">Hvað hún er, hvað hún er ekki og hvernig þú nýtir hana best á fimm mínútum.</p>
    </header>
    <section class="card-section">
      <h2 class="card-section-label">Hvað hún er</h2>
      <ul>
        <li><span>Uppflettirit fyrir kennara sem vinna með fjölbreyttum bekkjum. Hvert spjald tekur fyrir eina svipmynd nemanda og svarar þremur spurningum: hvað þú sérð í stofunni, hvað þú getur gert í dag og hvar gervigreind getur hjálpað.</span></li>
        <li><span>Hún er hönnuð til að gagnast á fimm mínútum: fyrir erfiða kennslustund, fyrir fund með forsjáraðilum, eða þegar samstarfsmaður vill annað álit á nemanda.</span></li>
        <li><span>Hún er opið efni sem er uppfært eftir því sem þekking höfundar þróast. Núverandi útgáfa er <strong>v0.1</strong>.</span></li>
      </ul>
    </section>
    <section class="card-section">
      <h2 class="card-section-label">Hvað hún er ekki</h2>
      <ul>
        <li><span><strong>Ekki greiningartæki.</strong> Ekkert spjald kemur í stað formlegs sálfræðilegs eða kennslufræðilegs mats.</span></li>
        <li><span><strong>Ekki klínísk handbók.</strong> Málfarið er vísvitandi aðgengilegt og miðað við stofuna, ekki við stofnun.</span></li>
        <li><span><strong>Ekki endanleg.</strong> Svipmyndirnar eru inngangar, ekki merkimiðar. Raunverulegur nemandi fellur sjaldan í einn flokk.</span></li>
      </ul>
    </section>
    <section class="card-section">
      <h2 class="card-section-label">Um gervigreindarhlutana</h2>
      <ul>
        <li><span>Hlutarnir <em>Hvar gervigreind kemur inn</em> standa vísvitandi auðir í þessari útgáfu. Höfundur situr sérhæft námskeið í Flórens (ágúst 2026) áður en hann mælir með tilteknum verkfærum.</span></li>
        <li><span>Uppbyggingin er tilbúin: hvert verkfæri fær notkunardæmi, tillögu að fyrirmælum og persónuverndarnótu. Efnið kemur í <strong>v0.2</strong>, áætlað í september 2026.</span></li>
      </ul>
    </section>
    <section class="card-section">
      <h2 class="card-section-label">Um þýðinguna</h2>
      <ul>
        <li><span>Efni spjaldanna er þýtt í heild á íslensku. Portúgalska er frumútgáfa handbókarinnar; í vafa gildir portúgalski textinn.</span></li>
        <li><span>Leiðsögn, merkingar og upplýsingasíður eru þýddar að fullu.</span></li>
      </ul>
    </section>
    <section class="card-section">
      <h2 class="card-section-label">Höfundur og leyfi</h2>
      <ul>
        <li><span>Hugsuð og stýrð af tungumálakennaranum <a href="https://guilhermegfmachado.github.io/work/" target="_blank" rel="noopener noreferrer">Guilherme de Góis Machado</a>.</span></li>
        <li><span>Gefin út undir leyfinu <strong>CC BY-NC-SA 4.0</strong>.</span></li>
        <li><span>Frumkóði: <a href="https://github.com/guilhermegfmachado/farol" target="_blank" rel="noopener noreferrer">github.com/guilhermegfmachado/farol</a>.</span></li>
      </ul>
    </section>
  </article>
  <Footer lang="is" />
</Base>
<style>
a { color: var(--accent); text-decoration: none; border-bottom: 1px solid var(--rule); transition: color 0.15s ease; }
a:hover { color: var(--accent-hover); }
</style>
