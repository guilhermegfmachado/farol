---
import { getCollection } from 'astro:content';
import { getAllEntries } from '@/lib/entries';
import { ui, allLangHrefs } from '@/lib/i18n';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

export async function getStaticPaths() {
  const entries = await getCollection('profiles');
  return entries.map((entry) => ({
    params: { slug: entry.id.replace(/\.md$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { title, category, subtitle, sections, ai_strategies, pending } = entry.data;
const references = entry.data.references ?? [];
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const slug = entry.id.replace(/\.md$/, '');
const langHrefs = allLangHrefs(base, 'profiles', slug);
const t = ui['pt'];

const allTools = await getCollection('tools');
const profileTools = allTools.filter((tool) => tool.data.profiles?.includes(slug));

const allProfiles = await getCollection('profiles');
const relatedSlugs = entry.data.related ?? [];
const relatedEntries = allProfiles.filter(p => relatedSlugs.includes(p.id.replace(/\.md$/, '')));

const allEntries = await getAllEntries();
const idx = allEntries.findIndex(
  (e) => e.collection === entry.collection && e.id === entry.id
);
const prev = idx > 0 ? allEntries[idx - 1] : null;
const next = idx < allEntries.length - 1 ? allEntries[idx + 1] : null;

function entryHref(e: typeof allEntries[0]) {
  return `${base}${e.collection}/${e.id.replace(/\.md$/, '')}/`;
}
---
<Base
  title={`${title} — Farol`}
  description={subtitle}
  ogTitle={`${title} · ${category} — Farol`}
  altHrefs={langHrefs}
>
  <Header lang="pt" altHrefs={langHrefs} />

  <Breadcrumb crumbs={[
    { label: 'início', href: base },
    { label: title.toLowerCase() },
  ]} />

  <article class="card animate-in">
    <header class="card-header">
      <div class="card-header-meta">
        <span class="card-category">{category}</span>
        <span class="card-index-large" aria-hidden="true">{entry.data.index}</span>
      </div>
      <h1 class="card-title">{title}</h1>
      <p class="card-subtitle">{subtitle}</p>
    </header>

    {sections.map((section) => (
      <section class="card-section">
        <h2 class="card-section-label">{section.label}</h2>
        <ul>
          {section.items.map((item) => (
            <li><span set:html={item} /></li>
          ))}
        </ul>
        {section.label === 'Estratégias sem IA' && (
          <a class="section-ref-link" href={`${base}references/diferenciacao/`}>Diferenciação Pedagógica →</a>
        )}
        {section.label === 'Sinais de alerta para referenciação' && (
          <a class="section-ref-link" href={`${base}references/legislacao/`}>Enquadramento Legal →</a>
        )}
      </section>
    ))}

    {ai_strategies && (
      <section class="card-section ai-section">
        <h2 class="card-section-label">Onde a IA entra</h2>
        {ai_strategies.pending ? (
          <div class="pending-notice">
            A preencher após o curso em Florença (Agosto 2026). A estrutura já está pronta — cada ferramenta terá: caso de uso, sugestão de prompt, e nota sobre privacidade.
          </div>
        ) : (
          <div class="ai-tools">
            {ai_strategies.tools.map((t) => (
              <div class="ai-tool">
                <div class="ai-tool-name">{t.tool}</div>
                <div class="ai-tool-use">{t.use}</div>
                {t.prompt && (
                  <div class="ai-tool-prompt">
                    <span class="ai-tool-prompt-label">Prompt</span>
                    <blockquote>{t.prompt}</blockquote>
                  </div>
                )}
                {t.caveats && (
                  <div class="ai-tool-caveats">{t.caveats}</div>
                )}
              </div>
            ))}
          </div>
        )}
      </section>
    )}

    {pending && <div class="pending-notice">{pending}</div>}
    {relatedEntries.length > 0 && (
      <div class="related-bar">
        <span class="related-label">Ver também</span>
        <div class="related-chips">
          {relatedEntries.map((rp) => (
            <a href={`${base}profiles/${rp.id.replace(/\.md$/, '')}/`} class="related-chip">
              {rp.data.title}
            </a>
          ))}
        </div>
      </div>
    )}
    {profileTools.length > 0 && (
      <section class="card-section tools-section">
        <h2 class="card-section-label">{t.tools_for_profile}</h2>
        <div class="tool-chips">
          {profileTools.map((tool) => (
            <a href={`${base}tools/${tool.id.replace(/\.md$/, '')}/`} class="tool-chip">
              <span class="tool-chip-name">{tool.data.name}</span>
              {tool.data.free && <span class="tool-chip-free">free</span>}
            </a>
          ))}
        </div>
      </section>
    )}
    {references.length > 0 && (
      <section class="card-section references-section">
        <h2 class="card-section-label">{t.references_label}</h2>
        <ol class="references-list">
          {references.map((ref, i) => (
            <li id={`ref-${i + 1}`}><span set:html={ref} /></li>
          ))}
        </ol>
      </section>
    )}
    <div class="print-bar"><button type="button" class="print-btn" onclick="window.print()">{t.print_card}</button></div>
  </article>

  <nav class="card-nav" aria-label="Navegação entre entradas">
    {prev ? (
      <a href={entryHref(prev)} class="card-nav-item card-nav-prev">
        <span class="card-nav-dir">← anterior</span>
        <span class="card-nav-title">{prev.data.title}</span>
      </a>
    ) : <span />}
    {next ? (
      <a href={entryHref(next)} class="card-nav-item card-nav-next">
        <span class="card-nav-dir">seguinte →</span>
        <span class="card-nav-title">{next.data.title}</span>
      </a>
    ) : <span />}
  </nav>

  <Footer lang="pt" />
</Base>

<style>
.ai-tools { display: flex; flex-direction: column; gap: 1rem; }
.ai-tool { border: 1px solid var(--rule); padding: 1.2rem 1.4rem; background: var(--bg); }
.ai-tool-name { font-family: 'JetBrains Mono', 'Mono Fallback', monospace; font-size: 0.8rem; font-weight: 500; color: var(--accent); letter-spacing: 0.05em; margin-bottom: 0.4rem; text-transform: uppercase; }
.ai-tool-use { color: var(--ink-soft); font-size: 0.95rem; line-height: 1.55; }
.ai-tool-prompt { margin-top: 0.8rem; }
.ai-tool-prompt-label { font-family: 'JetBrains Mono', 'Mono Fallback', monospace; font-size: 0.65rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-faded); display: block; margin-bottom: 0.4rem; }
.ai-tool-prompt blockquote { border-left: 2px solid var(--accent); padding: 0.5rem 0.9rem; font-size: 0.9rem; color: var(--ink-soft); font-style: italic; margin: 0; }
.ai-tool-caveats { margin-top: 0.7rem; font-size: 0.85rem; color: var(--warning); padding-top: 0.6rem; border-top: 1px dashed var(--rule); }

.card-nav { display: flex; justify-content: space-between; gap: 1rem; margin-top: 2rem; margin-bottom: 1rem; }
.card-nav-item { display: flex; flex-direction: column; gap: 0.2rem; padding: 0.9rem 1.2rem; border: 1px solid var(--rule); background: var(--bg-elevated); text-decoration: none; transition: border-color 0.15s ease; max-width: 48%; }
.card-nav-item:hover { border-color: var(--accent); }
.card-nav-next { text-align: right; margin-left: auto; }
.card-nav-dir { font-family: 'JetBrains Mono', 'Mono Fallback', monospace; font-size: 0.65rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-faded); }
.card-nav-title { font-size: 0.95rem; font-weight: 600; color: var(--ink); }

@media print {
  .card-nav { display: none; }
}

.tools-section { margin-top: 0; }
.tool-chips { display: flex; flex-wrap: wrap; gap: 0.5rem; }
.tool-chip { display: flex; align-items: center; gap: 0.35rem; padding: 0.35rem 0.7rem; border: 1px solid var(--rule); text-decoration: none; color: var(--ink-soft); font-size: 0.82rem; transition: border-color 0.15s ease, color 0.15s ease; background: var(--bg-elevated); }
.tool-chip:hover { border-color: var(--accent); color: var(--ink); }
.tool-chip-name { font-weight: 500; }
.tool-chip-free { font-family: 'JetBrains Mono', 'Mono Fallback', monospace; font-size: 0.6rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); }
.print-bar { margin-top: 1.5rem; display: flex; justify-content: flex-end; }
.print-btn { font-family: 'JetBrains Mono', 'Mono Fallback', monospace; font-size: 0.7rem; letter-spacing: 0.05em; background: none; border: 1px solid var(--rule); color: var(--ink-faded); padding: 0.4rem 0.9rem; cursor: pointer; transition: border-color 0.15s ease, color 0.15s ease; }
.print-btn:hover { border-color: var(--accent); color: var(--accent); }
@media print { .print-bar { display: none; } }

.section-ref-link { display: inline-block; margin-top: 0.6rem; font-family: 'JetBrains Mono', 'Mono Fallback', monospace; font-size: 0.7rem; letter-spacing: 0.04em; color: var(--accent); text-decoration: none; border-bottom: 1px solid var(--rule); padding-bottom: 0.1rem; transition: border-color 0.15s ease; }
.section-ref-link:hover { border-color: var(--accent); }

.related-bar { display: flex; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin: 1.25rem 0 0.5rem; padding: 0.75rem 1rem; border: 1px dashed var(--rule); background: var(--bg-elevated); }
.related-label { font-family: 'JetBrains Mono', 'Mono Fallback', monospace; font-size: 0.65rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-faded); white-space: nowrap; }
.related-chips { display: flex; flex-wrap: wrap; gap: 0.4rem; }
.related-chip { padding: 0.25rem 0.6rem; border: 1px solid var(--rule); font-size: 0.82rem; color: var(--ink-soft); text-decoration: none; background: var(--bg); transition: border-color 0.15s ease, color 0.15s ease; }
.related-chip:hover { border-color: var(--accent); color: var(--ink); }

</style>
