---
import { getAllEntries } from '@/lib/entries';
import { ui, allIndexHrefs } from '@/lib/i18n';
import { observations, obsThemes, obsText } from '@/lib/observations';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const entries = await getAllEntries();
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const t = ui['pt'];
---
<Base title="Farol — Inclusão & IA na Sala de Aula" altHrefs={allIndexHrefs(base)}>
  <Header lang="pt" altHrefs={allIndexHrefs(base)} tagline />

  <div class="intro">
    <div class="intro-label">Sobre</div>
    <div class="intro-body">
      <p>Este compêndio reúne estratégias práticas para docentes que trabalham com alunos neurodivergentes, sobredotados, ou sem proficiência na língua de ensino. Cada perfil tem um cartão de consulta rápida.</p>
      <a class="intro-more" href={`${base}sobre/`}>{t.about_more} →</a>
    </div>
  </div>

  <section class="observe">
    <div class="observe-head">
      <div class="observe-label">{t.observe_label}</div>
      <p class="observe-hint">{t.observe_hint}</p>
    </div>
    {obsThemes.map((th) => (
      <div class="observe-group">
        <div class="observe-theme">{th.label.pt}</div>
        <div class="observe-grid">
          {observations.filter((o) => th.profiles.includes(o.profile)).map((o) => (
            <a class="observe-chip" href={`${base}profiles/${o.profile}/`}>
              <span class="observe-chip-text">{obsText(o, 'pt')}</span>
              <span class="observe-chip-arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </div>
    ))}
  </section>
  <div class="browse-divider"><span>{t.browse_label}</span></div>


  <nav class="tree" aria-label="Perfis e recursos">
    <div class="tree-section-label">{t.home_profiles}</div>
    {entries.filter((entry) => entry.data.category === 'Perfil').map((entry) => (
      <a
        href={`${base}${entry.collection}/${entry.id.replace(/\.md$/, '')}/`}
        class="tree-node animate-in"
        data-category={entry.data.category}
      >
        <span class="tree-node-category">{entry.data.category}</span>
        <span class="tree-node-index" aria-hidden="true">{entry.data.index}</span>
        <span class="tree-node-title">{entry.data.title}</span>
        <span class="tree-node-desc">{entry.data.desc}</span>
        <span class="tree-node-arrow">consultar <span aria-hidden="true">→</span></span>
      </a>
    ))}
    <div class="tree-section-label">{t.home_refs}</div>
    {entries.filter((entry) => entry.data.category !== 'Perfil').map((entry) => (
      <a
        href={`${base}${entry.collection}/${entry.id.replace(/\.md$/, '')}/`}
        class="tree-node animate-in"
        data-category={entry.data.category}
      >
        <span class="tree-node-category">{entry.data.category}</span>
        <span class="tree-node-index" aria-hidden="true">{entry.data.index}</span>
        <span class="tree-node-title">{entry.data.title}</span>
        <span class="tree-node-desc">{entry.data.desc}</span>
        <span class="tree-node-arrow">consultar <span aria-hidden="true">→</span></span>
      </a>
    ))}
  
  </nav>

  <div class="tools-link-row">
    <a href={`${base}lighthouse/`} class="tools-link tools-link-lighthouse">
      <span class="tools-link-label">Visualização</span>
      <span class="tools-link-title">A Torre →</span>
      <span class="tools-link-desc">Ver todos os perfis e referências como uma torre de farol interativa</span>
    </a>
    <a href={`${base}tools/`} class="tools-link">
      <span class="tools-link-label">Catálogo</span>
      <span class="tools-link-title">Ferramentas de IA →</span>
      <span class="tools-link-desc">Fichas de ferramenta com notas de privacidade e mapeamento por perfil</span>
    </a>
  </div>

  <Footer lang="pt" />
</Base>

<style>
/* Category-tinted left border on tree nodes */
.tree-node[data-category="Perfil"]     { border-left: 3px solid var(--accent); }
.tree-node[data-category="Referência"] { border-left: 3px solid #4a7c59; }
.tree-node[data-category="Recurso"]    { border-left: 3px solid #7c5a3a; }

.tools-link { display: flex; flex-direction: column; gap: 0.3rem; padding: 1.2rem 1.5rem; background: var(--bg-elevated); border: 1px solid var(--rule); border-left: 3px solid var(--beam); text-decoration: none; transition: border-color 0.2s ease; }
.tools-link:hover { border-color: var(--beam); box-shadow: 0 2px 12px rgba(20,23,26,0.05); }
.tools-link-lighthouse { border-left-color: var(--accent); }
.tools-link-lighthouse:hover { border-color: var(--accent); }
.tools-link-label { font-family: 'JetBrains Mono', 'Mono Fallback', monospace; font-size: 0.65rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-faded); }
.tools-link-title { font-size: 1rem; font-weight: 600; color: var(--ink); }
.tools-link-desc { font-size: 0.85rem; color: var(--ink-soft); }
.search-bar { margin-bottom: 0.75rem; }
.search-input { width: 100%; box-sizing: border-box; font-family: 'JetBrains Mono', 'Mono Fallback', monospace; font-size: 0.8rem; padding: 0.55rem 0.9rem; border: 1px solid var(--rule); background: var(--bg-elevated); color: var(--ink); outline: none; transition: border-color 0.15s ease; }
.search-input:focus { border-color: var(--accent); }
.search-input::placeholder { color: var(--ink-faded); }
.search-empty { margin: 1rem 0; padding: 0.9rem 1rem; font-family: 'JetBrains Mono', 'Mono Fallback', monospace; font-size: 0.78rem; color: var(--ink-faded); border: 1px dashed var(--rule); text-align: center; }
</style>
