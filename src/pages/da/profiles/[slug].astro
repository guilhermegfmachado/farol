---
import { getCollection } from 'astro:content';
import { getAllEntries } from '@/lib/entries';
import { ui, entryTranslations, sectionLabelTranslations, allLangHrefs, categoryTranslations } from '@/lib/i18n';
import { contentTranslations } from '@/lib/content-translations';
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';

export async function getStaticPaths() {
  const entries = await getCollection('profiles');
  return entries.map((entry) => ({
    params: { slug: entry.id.replace(/\.md$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { category, sections, ai_strategies, pending } = entry.data;
const catLabel = categoryTranslations['da']?.[category] ?? category;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const slug = entry.id.replace(/\.md$/, '');
const t = ui['da'];
const tr = entryTranslations.da?.[slug];
const title = tr?.title ?? entry.data.title;
const subtitle = tr?.subtitle ?? entry.data.subtitle;
const langHrefs = allLangHrefs(base, 'profiles', slug);
const allTools = await getCollection('tools');
const allProfiles = await getCollection('profiles');
const relatedSlugs = entry.data.related ?? [];
const relatedEntries = allProfiles.filter(p => relatedSlugs.includes(p.id.replace(/\.md$/, '')));
const profileTools = allTools.filter((tool) => tool.data.profiles?.includes(slug));
const ct = contentTranslations['da']?.[slug];

const allEntries = await getAllEntries();
const idx = allEntries.findIndex(
  (e) => e.collection === entry.collection && e.id === entry.id
);
const prev = idx > 0 ? allEntries[idx - 1] : null;
const next = idx < allEntries.length - 1 ? allEntries[idx + 1] : null;

function entryHref(e: typeof allEntries[0]) {
  const s = e.id.replace(/\.md$/, '');
  const etr = entryTranslations.da?.[s];
  return { href: `${base}da/${e.collection}/${s}/`, title: etr?.title ?? e.data.title };
}
---
<Base title={`${title} — Farol`} description={subtitle} ogTitle={`${title} · ${catLabel} — Farol`} altHrefs={langHrefs}>
  <Header lang="da" altHrefs={langHrefs} />
  <Breadcrumb crumbs={[{ label: t.breadcrumb_home, href: `${base}da/` }, { label: title.toLowerCase() }]} />
  <article class="card animate-in">
    <header class="card-header">
      <div class="card-header-meta">
        <span class="card-category">{catLabel}</span>
        <span class="card-index-large">{entry.data.index}</span>
      </div>
      <h1 class="card-title">{title}</h1>
      {subtitle && <p class="card-subtitle">{subtitle}</p>}
    </header>
    {sections.map((section, i) => (
      <section class="card-section">
        <h2 class="card-section-label">{sectionLabelTranslations.da?.[section.label] ?? section.label}</h2>
        <ul>{(ct?.sections[i]?.items ?? section.items).map((item) => <li><span set:html={item} /></li>)}</ul>
        {section.label === 'Estratégias sem IA' && (
          <a class="section-ref-link" href={`${base}da/references/diferenciacao/`}>{entryTranslations.da?.diferenciacao?.title ?? 'Diferenciação Pedagógica'} →</a>
        )}
        {section.label === 'Sinais de alerta para referenciação' && (
          <a class="section-ref-link" href={`${base}da/references/legislacao/`}>{entryTranslations.da?.legislacao?.title ?? 'Enquadramento Legal'} →</a>
        )}
      </section>
    ))}
    {ai_strategies && (
      <section class="card-section ai-section">
        <h2 class="card-section-label">{sectionLabelTranslations.da?.['Onde a IA entra'] ?? 'AI'}</h2>
        {ai_strategies.pending ? <div class="pending-notice">{t.ai_pending}</div> : <div class="ai-tools">{ai_strategies.tools.map((tool) => <div class="ai-tool"><div class="ai-tool-name">{tool.tool}</div><div class="ai-tool-use">{tool.use}</div></div>)}</div>}
      </section>
    )}
    {pending && <div class="pending-notice">{t.translation_notice}</div>}
    {relatedEntries.length > 0 && (
      <div class="related-bar">
        <span class="related-label">{t.see_also}</span>
        <div class="related-chips">
          {relatedEntries.map((rp) => {
            const rs = rp.id.replace(/\.md$/, '');
            const rtr = entryTranslations.da?.[rs];
            return (
              <a href={`${base}da/profiles/${rs}/`} class="related-chip">
                {rtr?.title ?? rp.data.title}
              </a>
            );
          })}
        </div>
      </div>
    )}
    {profileTools.length > 0 && (
      <section class="card-section tools-section">
        <h2 class="card-section-label">{t.tools_for_profile}</h2>
        <div class="tool-chips">
          {profileTools.map((tool) => (
            <a href={`${base}da/tools/${tool.id.replace(/\.md$/, '')}/`} class="tool-chip">
              <span class="tool-chip-name">{tool.data.name}</span>
              {tool.data.free && <span class="tool-chip-free">free</span>}
            </a>
          ))}
        </div>
      </section>
    )}
    <div class="print-bar"><button type="button" class="print-btn" onclick="window.print()">{t.print_card}</button></div>
  </article>
  <nav class="card-nav" aria-label="Navigation mellem indgange">
    {prev ? <a href={entryHref(prev).href} class="card-nav-item card-nav-prev"><span class="card-nav-dir">{t.nav_prev}</span><span class="card-nav-title">{entryHref(prev).title}</span></a> : <span />}
    {next ? <a href={entryHref(next).href} class="card-nav-item card-nav-next"><span class="card-nav-dir">{t.nav_next}</span><span class="card-nav-title">{entryHref(next).title}</span></a> : <span />}
  </nav>
  <Footer lang="da" />
</Base>
<style>
.card-nav { display: flex; justify-content: space-between; gap: 1rem; margin-top: 2rem; margin-bottom: 1rem; }
.card-nav-item { display: flex; flex-direction: column; gap: 0.2rem; padding: 0.9rem 1.2rem; border: 1px solid var(--rule); background: var(--bg-elevated); text-decoration: none; transition: border-color 0.15s ease; max-width: 48%; }
.card-nav-item:hover { border-color: var(--accent); }
.card-nav-next { text-align: right; margin-left: auto; }
.card-nav-dir { font-family: 'JetBrains Mono', monospace; font-size: 0.65rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-faded); }
.card-nav-title { font-size: 0.95rem; font-weight: 600; color: var(--ink); }
@media print { .card-nav { display: none; } }

.tools-section { margin-top: 0; }
.tool-chips { display: flex; flex-wrap: wrap; gap: 0.5rem; }
.tool-chip { display: flex; align-items: center; gap: 0.35rem; padding: 0.35rem 0.7rem; border: 1px solid var(--rule); text-decoration: none; color: var(--ink-soft); font-size: 0.82rem; transition: border-color 0.15s ease, color 0.15s ease; background: var(--bg-elevated); }
.tool-chip:hover { border-color: var(--accent); color: var(--ink); }
.tool-chip-name { font-weight: 500; }
.tool-chip-free { font-family: 'JetBrains Mono', monospace; font-size: 0.6rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); }
.print-bar { margin-top: 1.5rem; display: flex; justify-content: flex-end; }
.print-btn { font-family: 'JetBrains Mono', monospace; font-size: 0.7rem; letter-spacing: 0.05em; background: none; border: 1px solid var(--rule); color: var(--ink-faded); padding: 0.4rem 0.9rem; cursor: pointer; transition: border-color 0.15s ease, color 0.15s ease; }
.print-btn:hover { border-color: var(--accent); color: var(--accent); }
@media print { .print-bar { display: none; } }

.section-ref-link { display: inline-block; margin-top: 0.6rem; font-family: 'JetBrains Mono', monospace; font-size: 0.7rem; letter-spacing: 0.04em; color: var(--accent); text-decoration: none; border-bottom: 1px solid var(--rule); padding-bottom: 0.1rem; transition: border-color 0.15s ease; }
.section-ref-link:hover { border-color: var(--accent); }

.related-bar { display: flex; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin: 1.25rem 0 0.5rem; padding: 0.75rem 1rem; border: 1px dashed var(--rule); background: var(--bg-elevated); }
.related-label { font-family: 'JetBrains Mono', monospace; font-size: 0.65rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-faded); white-space: nowrap; }
.related-chips { display: flex; flex-wrap: wrap; gap: 0.4rem; }
.related-chip { padding: 0.25rem 0.6rem; border: 1px solid var(--rule); font-size: 0.82rem; color: var(--ink-soft); text-decoration: none; background: var(--bg); transition: border-color 0.15s ease, color 0.15s ease; }
.related-chip:hover { border-color: var(--accent); color: var(--ink); }

</style>
