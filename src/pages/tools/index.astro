---
import { getCollection } from 'astro:content';
import { ui, allSectionHrefs } from '@/lib/i18n';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const tools = await getCollection('tools');
tools.sort((a, b) => a.data.name.localeCompare(b.data.name, 'pt'));

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const t = ui['pt'];

const categoryLabel: Record<string, string> = {
  'geração de texto': 'Geração de texto',
  'texto-para-voz':   'Texto-para-voz',
  'tradução':         'Tradução',
  'organização':      'Organização',
  'imagem':           'Imagem',
  'outro':            'Outro',
};
---
<Base
  title="Ferramentas — Farol"
  description="Catálogo de ferramentas de IA para uso em contexto educativo, com notas de privacidade e mapeamento por perfil de aluno."
  altHrefs={allSectionHrefs(base, 'tools')}
>
  <Header altHrefs={allSectionHrefs(base, 'tools')} />

  <Breadcrumb lang="pt" crumbs={[
    { label: 'início', href: base },
    { label: 'ferramentas' },
  ]} />

  <div class="prompt-section">
    <div class="prompt-label">{t.tools_catalog}</div>
    <h1 class="prompt-question">{t.tools_question}</h1>
  </div>

  <div class="search-bar"><input id="card-search" type="search" class="search-input" placeholder={t.tools_search_placeholder} aria-label={t.tools_search_placeholder} /></div>
  <nav class="tree" aria-label="Ferramentas">
    {tools.map((tool) => (
      <a
        href={`${base}tools/${tool.id.replace(/\.md$/, '')}/`}
        class="tree-node animate-in"
        data-category="Ferramenta"
      >
        <span class="tree-node-category">{categoryLabel[tool.data.category] ?? tool.data.category}</span>
        <span class="tree-node-title">{tool.data.name}</span>
        <span class="tree-node-desc">{tool.data.desc}</span>
        {tool.data.free !== undefined && (
          <span class="tree-node-tag">{tool.data.free ? t.tool_free : t.tool_paid}</span>
        )}
        <span class="tree-node-arrow">ver ficha <span aria-hidden="true">→</span></span>
      </a>
    ))}
  </nav>
  <p class="search-empty" id="search-empty" hidden>{t.no_results}</p>

  <Footer />
</Base>

<script is:inline>
(function() {
  var input = document.getElementById('card-search');
  var nodes = document.querySelectorAll('.tree-node');
  var empty = document.getElementById('search-empty');
  if (!input || !nodes.length) return;
  input.addEventListener('input', function() {
    var q = this.value.trim().toLowerCase();
    var shown = 0;
    nodes.forEach(function(node) {
      var match = !q || node.textContent.toLowerCase().includes(q);
      node.style.display = match ? '' : 'none';
      if (match) shown++;
    });
    if (empty) empty.hidden = shown !== 0;
  });
})();
</script>


<style>
.search-bar { margin-bottom: 0.75rem; }
.search-input { width: 100%; box-sizing: border-box; font-family: 'JetBrains Mono', 'Mono Fallback', monospace; font-size: 0.8rem; padding: 0.55rem 0.9rem; border: 1px solid var(--rule); background: var(--bg-elevated); color: var(--ink); outline: none; transition: border-color 0.15s ease; }
.search-input:focus { border-color: var(--accent); }
.search-input::placeholder { color: var(--ink-faded); }
.search-empty { margin: 1rem 0; padding: 0.9rem 1rem; font-family: 'JetBrains Mono', 'Mono Fallback', monospace; font-size: 0.78rem; color: var(--ink-faded); border: 1px dashed var(--rule); text-align: center; }
</style>
