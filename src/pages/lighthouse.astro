---
import { getAllEntries } from '@/lib/entries';
import { allIndexHrefs, ui } from '@/lib/i18n';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const entries = await getAllEntries();
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const t = ui['pt'];

const sorted = [...entries].sort((a, b) =>
  (a.data.index || '99').localeCompare(b.data.index || '99')
);
const tower = [...sorted].reverse();

const categoryColor: Record<string, string> = {
  'Perfil':     'var(--accent)',
  'Referência': '#4a7c59',
  'Recurso':    '#7c5a3a',
};
---
<Base title="A Torre — Farol" description="Visualização em farol dos perfis e referências de sala de aula inclusiva.">
  <Header lang="pt" altHrefs={allIndexHrefs(base)} />

  <div class="lh-page">
    <div class="lh-intro">
      <div class="lh-intro-label">Visualização</div>
      <h1 class="lh-intro-title">{t.lh_title}</h1>
      <p class="lh-intro-desc">{t.lh_desc}</p>
    </div>

    <div class="lh-scene">

      <!-- Sky with a few stars -->
      <div class="lh-sky" aria-hidden="true">
        <div class="lh-star" style="top:14%;left:10%;animation-delay:0s"></div>
        <div class="lh-star" style="top:7%;left:40%;animation-delay:1.1s"></div>
        <div class="lh-star" style="top:18%;left:72%;animation-delay:0.5s"></div>
        <div class="lh-star" style="top:5%;left:85%;animation-delay:1.9s"></div>
      </div>

      <!-- Beacon cap + glowing orb -->
      <div class="lh-lantern" aria-hidden="true">
        <div class="lh-cap"></div>
        <div class="lh-beacon"></div>
        <div class="lh-cap-base"></div>
      </div>

      <!-- Tapering tower with clickable floors -->
      <div class="lh-tower-wrap">
        <div class="lh-tower" role="navigation" aria-label="Torre de estratégias">
          {tower.map((entry, i) => {
            const href = `${base}${entry.collection}/${entry.id.replace(/\.md$/, '')}/`;
            const color = categoryColor[entry.data.category] || 'var(--accent)';
            return (
              <a
                href={href}
                class={`lh-floor${i === tower.length - 1 ? ' lh-floor-bottom' : ''}`}
                style={`--fc: ${color};`}
              >
                <span class="lh-floor-num">{entry.data.index}</span>
                <span class="lh-floor-name">{entry.data.title}</span>
                <span class="lh-floor-arrow" aria-hidden="true">→</span>
              </a>
            );
          })}
        </div>
      </div>

      <!-- Door -->
      <div class="lh-door" aria-hidden="true">
        <div class="lh-door-arch"></div>
      </div>

      <!-- Base platform -->
      <div class="lh-base" aria-hidden="true"></div>

      <!-- Water -->
      <div class="lh-water" aria-hidden="true"></div>

    </div>

    <!-- Legend -->
    <div class="lh-panel">
      <div class="lh-legend">
        <span class="lh-legend-heading">{t.lh_categories}</span>
        <span class="lh-legend-item" style="--c:var(--accent)">Perfil</span>
        <span class="lh-legend-item" style="--c:#4a7c59">Referência</span>
        <span class="lh-legend-item" style="--c:#7c5a3a">Recurso</span>
      </div>
    </div>

    <div class="lh-back">
      <a href={base} class="lh-back-link">← {t.lh_back}</a>
    </div>
  </div>

  <Footer lang="pt" />
</Base>

<style>
/* ── Page ─────────────────────────────────────────────────── */
.lh-page { max-width: 520px; margin: 0 auto; }
.lh-intro { margin-bottom: 2rem; }
.lh-intro-label { font-family: 'JetBrains Mono', monospace; font-size: 0.7rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--ink-faded); margin-bottom: 0.4rem; }
.lh-intro-title { font-size: 2rem; font-weight: 700; color: var(--ink); margin-bottom: 0.5rem; }
.lh-intro-desc { color: var(--ink-soft); font-size: 0.9rem; max-width: 50ch; line-height: 1.6; }

/* ── Scene ────────────────────────────────────────────────── */
.lh-scene {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: linear-gradient(to bottom, #0e1c2e 0%, #152535 45%, #1a4060 75%, #1a7090 100%);
  border-radius: 2px;
  overflow: hidden;
  min-height: 520px;
  padding-bottom: 0;
}

/* ── Stars ────────────────────────────────────────────────── */
.lh-sky { position: absolute; inset: 0; pointer-events: none; }
.lh-star {
  position: absolute;
  width: 2px; height: 2px;
  background: #fff;
  border-radius: 50%;
  animation: twinkle 3.5s ease-in-out infinite;
}
@keyframes twinkle {
  0%, 100% { opacity: 0.15; }
  50%       { opacity: 0.8; }
}

/* ── Beacon ───────────────────────────────────────────────── */
.lh-lantern {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 36px;
}
.lh-cap {
  width: 0; height: 0;
  border-left: 14px solid transparent;
  border-right: 14px solid transparent;
  border-bottom: 12px solid #8a9099;
}
.lh-beacon {
  width: 28px; height: 28px;
  border-radius: 50%;
  background: radial-gradient(circle at 38% 38%, #ffe57a, #e8a83c 55%, #c07010 100%);
  box-shadow: 0 0 18px 7px rgba(232,168,60,0.65), 0 0 40px 16px rgba(232,168,60,0.2);
  animation: beaconPulse 2.5s ease-in-out infinite;
}
.lh-cap-base {
  width: 36px; height: 5px;
  background: #6b7280;
  border-radius: 0 0 2px 2px;
}
@keyframes beaconPulse {
  0%, 100% { box-shadow: 0 0 14px 5px rgba(232,168,60,0.55), 0 0 32px 12px rgba(232,168,60,0.18); }
  50%       { box-shadow: 0 0 26px 10px rgba(232,168,60,0.85), 0 0 56px 24px rgba(232,168,60,0.3); }
}

/* ── Tower ────────────────────────────────────────────────── */
.lh-tower-wrap {
  position: relative;
  z-index: 2;
  width: 100%;
  max-width: 272px;
  clip-path: polygon(7% 0%, 93% 0%, 100% 100%, 0% 100%);
}
.lh-tower {
  display: flex;
  flex-direction: column;
}
.lh-floor {
  display: flex;
  align-items: center;
  gap: 0.65rem;
  padding: 0.65rem 1rem;
  border-bottom: 1px solid rgba(255,255,255,0.06);
  border-left: 3px solid var(--fc, var(--accent));
  background: rgba(14, 24, 38, 0.72);
  text-decoration: none;
  color: #dce4ee;
  transition: background 0.15s ease, border-left-width 0.15s ease;
}
.lh-floor:hover {
  background: rgba(30, 55, 80, 0.65);
  border-left-width: 5px;
}
.lh-floor-bottom { border-bottom: none; }

.lh-floor-num {
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.95rem;
  font-weight: 700;
  color: rgba(255,255,255,0.2);
  min-width: 1.5rem;
  flex-shrink: 0;
  transition: color 0.15s ease;
}
.lh-floor:hover .lh-floor-num { color: var(--fc, var(--accent)); }
.lh-floor-name { flex: 1; font-size: 0.85rem; font-weight: 600; line-height: 1.2; }
.lh-floor-arrow {
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.7rem;
  color: rgba(255,255,255,0.18);
  flex-shrink: 0;
  transition: color 0.15s ease, transform 0.15s ease;
}
.lh-floor:hover .lh-floor-arrow { color: var(--fc, var(--accent)); transform: translateX(3px); }

/* ── Door ─────────────────────────────────────────────────── */
.lh-door {
  z-index: 2;
  width: 100%;
  max-width: 272px;
  height: 18px;
  background: rgba(14, 24, 38, 0.82);
  display: flex;
  justify-content: center;
  align-items: flex-end;
}
.lh-door-arch {
  width: 24px; height: 18px;
  background: #0e1c2e;
  border-radius: 12px 12px 0 0;
  border: 1px solid rgba(255,255,255,0.08);
  border-bottom: none;
}

/* ── Base ─────────────────────────────────────────────────── */
.lh-base {
  z-index: 2;
  width: 100%;
  max-width: 320px;
  height: 14px;
  background: linear-gradient(to bottom, #3d4a5a, #252f3d);
  border-top: 2px solid #5a6678;
}

/* ── Water ────────────────────────────────────────────────── */
.lh-water {
  z-index: 1;
  width: 100%;
  flex: 1;
  min-height: 36px;
  background: linear-gradient(to bottom, #1a7090 0%, #0e4f68 100%);
}

/* ── Legend ───────────────────────────────────────────────── */
.lh-panel { margin-top: 1.5rem; }
.lh-legend { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
.lh-legend-heading {
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.65rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--ink-faded);
}
.lh-legend-item {
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.7rem;
  color: var(--c);
  display: flex;
  align-items: center;
  gap: 0.35rem;
}
.lh-legend-item::before {
  content: '';
  display: inline-block;
  width: 8px; height: 8px;
  background: var(--c);
  border-radius: 1px;
}

/* ── Back link ────────────────────────────────────────────── */
.lh-back { margin-top: 2rem; margin-bottom: 0.5rem; }
.lh-back-link {
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.75rem;
  color: var(--ink-faded);
  text-decoration: none;
  transition: color 0.15s ease;
  letter-spacing: 0.03em;
}
.lh-back-link:hover { color: var(--accent); }

/* ── Mobile ───────────────────────────────────────────────── */
@media (max-width: 520px) {
  .lh-intro-title { font-size: 1.6rem; }
  .lh-tower-wrap, .lh-door { max-width: 230px; }
  .lh-base { max-width: 274px; }
  .lh-floor { padding: 0.55rem 0.75rem; gap: 0.45rem; }
  .lh-floor-num { font-size: 0.82rem; min-width: 1.2rem; }
  .lh-floor-name { font-size: 0.76rem; }
  .lh-scene { min-height: 460px; }
}
</style>
