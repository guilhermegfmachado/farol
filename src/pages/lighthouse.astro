---
import { allSectionHrefs, ui } from '@/lib/i18n';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Tower from '../components/Tower.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const t = ui['pt'];
---
<Base title="A Torre — Farol" description="Visualização em farol dos perfis e referências de sala de aula inclusiva." altHrefs={allSectionHrefs(base, 'lighthouse')}>
  <Header lang="pt" altHrefs={allSectionHrefs(base, 'lighthouse')} />

  <Breadcrumb lang="pt" crumbs={[{ label: t.breadcrumb_home, href: `${base}` }, { label: t.lh_title.toLowerCase() }]} />

  <div class="lh-page">
    <div class="lh-intro">
      <div class="lh-intro-label">Visualização</div>
      <h1 class="lh-intro-title">{t.lh_title}</h1>
      <p class="lh-intro-desc">{t.lh_desc}</p>
    </div>

    <Tower lang="pt" label={t.lh_title} />

    <div class="lh-panel">
      <div class="lh-legend">
        <span class="lh-legend-heading">{t.lh_categories}</span>
        <span class="lh-legend-item" style="--c:#6fa8a3">Perfil</span>
        <span class="lh-legend-item" style="--c:#cf9633">Referência</span>
      </div>
    </div>

  </div>

  <Footer lang="pt" />
</Base>

<style>
/* ── Page ─────────────────────────────────────────────────── */
.lh-page { max-width: 520px; margin: 0 auto; }
.lh-intro { margin-bottom: 2rem; }
.lh-intro-label { font-family: 'JetBrains Mono', 'Mono Fallback', monospace; font-size: 0.7rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--ink-faded); margin-bottom: 0.4rem; }
.lh-intro-title { font-size: 2rem; font-weight: 700; color: var(--ink); margin-bottom: 0.5rem; }
.lh-intro-desc { color: var(--ink-soft); font-size: 0.9rem; max-width: 50ch; line-height: 1.6; }

/* ── Legend ───────────────────────────────────────────────── */
.lh-panel { margin-top: 1.5rem; }
.lh-legend { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
.lh-legend-heading {
  font-family: 'JetBrains Mono', 'Mono Fallback', monospace;
  font-size: 0.65rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--ink-faded);
}
.lh-legend-item {
  font-family: 'JetBrains Mono', 'Mono Fallback', monospace;
  font-size: 0.7rem;
  color: var(--ink);
  display: flex;
  align-items: center;
  gap: 0.35rem;
}
.lh-legend-item::before {
  content: '';
  display: inline-block;
  width: 8px; height: 8px;
  background: var(--c);
  border-radius: 1px;
}

@media (max-width: 520px) {
  .lh-intro-title { font-size: 1.6rem; }
}
</style>
