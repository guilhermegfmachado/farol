---
import '../styles/global.css';
// Preload the primary body font (Plus Jakarta Sans, latin) so it is available at
// first paint on every entry page — the Portuguese root included — keeping the
// typography consistent across all languages and avoiding a fallback-font flash.
import jakartaWoff2 from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url';
import { ui } from '@/lib/i18n';

interface Props {
  title: string;
  description?: string;
  ogTitle?: string;
  altHrefs?: Partial<Record<string, string>>;
}

const {
  title,
  description = 'Ferramentas e Abordagens para Reconhecer e Orientar alunos — manual de bolso para docentes sobre inclusão e IA na sala de aula.',
  ogTitle,
  altHrefs = {},
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const pageLang = Astro.url.pathname.split('/').find(p => /^[a-z]{2}$/.test(p)) ?? 'pt';
const skipLabel = (ui as Record<string, { skip_to_content?: string }>)[pageLang]?.skip_to_content ?? 'Skip to content';
const ogImage = Astro.site ? new URL(`${base}og-image.png`, Astro.site) : `${base}og-image.png`;
---
<!doctype html>
<html lang={pageLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Preload the primary body font so the same typography renders on first paint everywhere -->
    <link rel="preload" href={jakartaWoff2} as="font" type="font/woff2" crossorigin />

    <!-- Night mode is opt-in only (lighthouse toggle in the header); restore before paint -->
    <script is:inline>
      try { if (localStorage.getItem('farol-theme') === 'dark') document.documentElement.classList.add('dark'); } catch (e) {}
      try { if (localStorage.getItem('farol-reading') === '1') document.documentElement.classList.add('reading'); } catch (e) {}
      try { var ts = localStorage.getItem('farol-textsize'); if (ts === 'lg' || ts === 'xl') document.documentElement.classList.add('text-' + ts); } catch (e) {}
    </script>

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />

    <!-- Installable PWA: works offline once a page has been visited -->
    <link rel="manifest" href={`${base}manifest.webmanifest`} />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#131722" media="(prefers-color-scheme: dark)" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Farol" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={ogTitle ?? title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={pageLang} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <!-- hreflang alternate links -->
    {Object.entries(altHrefs).map(([lang, href]) => (
      <link rel="alternate" hreflang={lang} href={new URL(href, Astro.site)} />
    ))}
    {altHrefs['pt'] && <link rel="alternate" hreflang="x-default" href={new URL(altHrefs['pt'], Astro.site)} />}
  </head>
  <body>
    <a class="skip-link" href="#main-content">{skipLabel}</a>
    <main class="container" id="main-content">
      <slot />
    </main>
    <!-- Language suggestion banner -->
    <script is:inline>
    (function() {
      try {
        if (localStorage.getItem('farol-lang-banner-dismissed')) return;
        var browserLang = (navigator.language || '').toLowerCase().slice(0, 2);
        var pageLang = document.documentElement.lang || 'pt';
        var langMap = {
          pt: '', en: 'en', es: 'es', fr: 'fr', it: 'it', hr: 'hr', de: 'de',
          nl: 'nl', pl: 'pl', ro: 'ro', cs: 'cs', sv: 'sv', da: 'da', fi: 'fi',
          sk: 'sk', el: 'el', hu: 'hu', bg: 'bg', lt: 'lt', lv: 'lv', et: 'et',
          sl: 'sl', ga: 'ga', mt: 'mt'
        };
        var langNames = {
          pt: 'Português', en: 'English', es: 'Español', fr: 'Français', it: 'Italiano',
          hr: 'Hrvatski', de: 'Deutsch', nl: 'Nederlands', pl: 'Polski', ro: 'Română',
          cs: 'Čeština', sv: 'Svenska', da: 'Dansk', fi: 'Suomi', sk: 'Slovenčina',
          el: 'Ελληνικά', hu: 'Magyar', bg: 'Български', lt: 'Lietuvių', lv: 'Latviešu',
          et: 'Eesti', sl: 'Slovenščina', ga: 'Gaeilge', mt: 'Malti'
        };
        if (browserLang in langMap && browserLang !== pageLang) {
          var base = document.querySelector('link[rel="alternate"][hreflang="' + browserLang + '"]');
          var targetHref = base ? base.href : null;
          if (!targetHref) return;
          var banner = document.createElement('div');
          banner.id = 'lang-banner';
          banner.innerHTML = '<span>' + langNames[browserLang] + ' available — <a href="' + targetHref + '">' + langNames[browserLang] + '</a></span><button onclick="document.getElementById(\'lang-banner\').remove();try{localStorage.setItem(\'farol-lang-banner-dismissed\',\'1\')}catch(e){}" aria-label="Dismiss">✕</button>';
          document.body.prepend(banner);
        }
      } catch (e) {}
    })();
    </script>

    <!-- PDF export: works on every device (incl. mobile, where window.print() is a no-op).
         The generator is loaded ONLY when the button is clicked, so page loads stay zero-JS. -->
    <script>
      (function () {
        var btn = document.querySelector('.print-btn');
        if (!btn) return;
        btn.removeAttribute('onclick'); // replace the fragile window.print() with a real download
        var busy = false;
        btn.addEventListener('click', async function () {
          if (busy) return;
          var card = document.querySelector('.card') || document.getElementById('main-content');
          if (!card) { try { window.print(); } catch (e) {} return; }
          busy = true;
          var root = document.documentElement;
          var hadDark = root.classList.contains('dark');
          var hadReading = root.classList.contains('reading');
          var bar = card.querySelector('.print-bar');
          var opened = [];
          var label = btn.textContent;
          btn.setAttribute('aria-busy', 'true');
          btn.textContent = label.replace(/\s*·.*$/, '') + ' …';
          root.classList.remove('dark', 'reading');            // always export light
          card.querySelectorAll('details:not([open])').forEach(function (d) { d.open = true; opened.push(d); });
          if (bar) bar.style.display = 'none';
          try {
            var html2pdf = (await import('html2pdf.js')).default;
            var name = (document.title || 'farol').replace(/\s*—.*$/, '').replace(/[^\p{L}\p{N}]+/gu, '_').replace(/^_+|_+$/g, '') || 'farol';
            await html2pdf().set({
              margin: [10, 12, 12, 12],
              filename: name + '.pdf',
              image: { type: 'jpeg', quality: 0.98 },
              html2canvas: { scale: 2, useCORS: true, backgroundColor: '#ffffff', windowWidth: 820 },
              jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' },
              pagebreak: { mode: ['css', 'legacy'] }
            }).from(card).save();
          } catch (err) {
            try { window.print(); } catch (e) {}   // fallback to the print dialog
          } finally {
            if (bar) bar.style.display = '';
            opened.forEach(function (d) { d.open = false; });
            if (hadDark) root.classList.add('dark');
            if (hadReading) root.classList.add('reading');
            btn.removeAttribute('aria-busy');
            btn.textContent = label;
            busy = false;
          }
        });
      })();
    </script>

    <!-- "My toolkit" — save profiles/tools to this device only (localStorage).
         Nothing is sent anywhere; works offline. Powers the star buttons and the
         header count badge; the toolkit page reads the same store. -->
    <script is:inline>
      (function () {
        var KEY = 'farol-saved';
        function read() {
          try { var v = JSON.parse(localStorage.getItem(KEY) || '{}'); return { profile: v.profile || [], tool: v.tool || [] }; }
          catch (e) { return { profile: [], tool: [] }; }
        }
        function write(s) { try { localStorage.setItem(KEY, JSON.stringify(s)); } catch (e) {} }
        function total(s) { return s.profile.length + s.tool.length; }
        function updateCounts(s) {
          var n = total(s);
          document.querySelectorAll('[data-toolkit-count]').forEach(function (el) {
            el.textContent = n ? String(n) : '';
            el.hidden = n === 0;
          });
        }
        function reflect(btn, on) {
          btn.setAttribute('aria-pressed', on ? 'true' : 'false');
          var lbl = on ? btn.getAttribute('data-label-saved') : btn.getAttribute('data-label');
          if (lbl) { btn.setAttribute('aria-label', lbl); btn.setAttribute('title', lbl); }
          var span = btn.querySelector('.star-label');
          if (span && lbl) span.textContent = lbl;
        }
        function init() {
          var s = read();
          document.querySelectorAll('.star-btn').forEach(function (btn) {
            var type = btn.getAttribute('data-save-type');
            var id = btn.getAttribute('data-save-id');
            reflect(btn, (s[type] || []).indexOf(id) !== -1);
          });
          updateCounts(s);
        }
        document.addEventListener('click', function (e) {
          var btn = e.target.closest ? e.target.closest('.star-btn') : null;
          if (!btn) return;
          var type = btn.getAttribute('data-save-type');
          var id = btn.getAttribute('data-save-id');
          var s = read();
          var arr = s[type] || (s[type] = []);
          var i = arr.indexOf(id);
          if (i === -1) arr.push(id); else arr.splice(i, 1);
          write(s);
          reflect(btn, i === -1);
          updateCounts(s);
          // let the toolkit page re-render if it is listening
          document.dispatchEvent(new CustomEvent('farol-saved-changed', { detail: s }));
        });
        // keep the header badge in sync when the toolkit page removes items
        document.addEventListener('farol-saved-changed', function (e) { updateCounts(e.detail || read()); });
        // expose the reader for the toolkit page
        window.farolSaved = read;
        if (document.readyState !== 'loading') init();
        else document.addEventListener('DOMContentLoaded', init);
      })();
    </script>

    <!-- Full-text search: only on pages whose search box opts in via
         data-search-index. Fetches a per-language index (lazily, on first
         keystroke) and shows matches across profiles, references and tools. -->
    <script is:inline>
      (function () {
        var input = document.querySelector('#card-search[data-search-index]');
        var results = document.getElementById('search-results');
        if (!input || !results) return;
        var lang = input.getAttribute('data-search-lang') || 'pt';
        var idxBase = input.getAttribute('data-search-base') || '/farol/';
        var empty = document.getElementById('search-empty');
        var browseEls = ['.tree', '.observe', '.browse-divider', '.tools-link-row'].map(function (s) { return document.querySelector(s); });
        var index = null, loading = false, pending = null;
        function setBrowse(v) { browseEls.forEach(function (el) { if (el) el.style.display = v ? '' : 'none'; }); }
        function ensure(cb) {
          if (index) { cb(); return; }
          pending = cb;
          if (loading) return;
          loading = true;
          fetch(idxBase + 'search/' + lang + '.json')
            .then(function (r) { return r.json(); })
            .then(function (d) { index = d; loading = false; if (pending) pending(); })
            .catch(function () { loading = false; });
        }
        function render(q) {
          var toks = q.split(/\s+/).filter(Boolean);
          var hits = index.filter(function (it) { return toks.every(function (tk) { return it.x.indexOf(tk) !== -1; }); });
          results.innerHTML = '';
          if (!hits.length) { if (empty) empty.hidden = false; results.hidden = true; return; }
          if (empty) empty.hidden = true;
          hits.slice(0, 40).forEach(function (it) {
            var a = document.createElement('a'); a.className = 'search-result'; a.href = it.u;
            a.setAttribute('data-category', it.k || '');
            var c = document.createElement('span'); c.className = 'search-result-cat'; c.textContent = it.c;
            var t = document.createElement('span'); t.className = 'search-result-title'; t.textContent = it.t;
            var s = document.createElement('span'); s.className = 'search-result-snip'; s.textContent = it.s;
            a.appendChild(c); a.appendChild(t); if (it.s) a.appendChild(s);
            results.appendChild(a);
          });
          results.hidden = false;
        }
        input.addEventListener('input', function () {
          var q = this.value.trim().toLowerCase();
          if (q.length < 2) { setBrowse(true); results.hidden = true; results.innerHTML = ''; if (empty) empty.hidden = true; return; }
          setBrowse(false);
          ensure(function () { render(q); });
        });
      })();
    </script>

    <!-- Register the service worker so the manual is installable and works
         offline. Registered after load so it never competes with first paint. -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          var base = document.querySelector('link[rel="manifest"]');
          var scope = base ? base.href.replace(/manifest\.webmanifest.*$/, '') : '/farol/';
          navigator.serviceWorker.register(scope + 'sw.js', { scope: scope }).catch(function () {});
        });
      }
    </script>
  </body>
</html>

<style is:global>
.skip-link {
  position: absolute;
  left: -9999px;
  top: auto;
  width: 1px;
  height: 1px;
  overflow: hidden;
}
.skip-link:focus {
  position: fixed;
  top: 0.5rem;
  left: 0.5rem;
  width: auto;
  height: auto;
  background: var(--accent);
  color: #fff;
  padding: 0.5rem 1rem;
  font-family: 'JetBrains Mono', 'Mono Fallback', monospace;
  font-size: 0.8rem;
  z-index: 9999;
  border-radius: 2px;
  text-decoration: none;
}
#lang-banner {
  position: fixed;
  bottom: 1rem;
  left: 50%;
  transform: translateX(-50%);
  background: var(--bg-elevated);
  border: 1px solid var(--rule-strong);
  padding: 0.65rem 1rem;
  display: flex;
  align-items: center;
  gap: 0.75rem;
  font-family: 'JetBrains Mono', 'Mono Fallback', monospace;
  font-size: 0.72rem;
  color: var(--ink-soft);
  z-index: 100;
  box-shadow: 0 4px 20px rgba(0,0,0,0.12);
  max-width: 90vw;
}
#lang-banner a { color: var(--accent); text-decoration: none; font-weight: 600; }
#lang-banner button { background: none; border: none; cursor: pointer; color: var(--ink-faded); font-size: 0.7rem; padding: 0; line-height: 1; }
#lang-banner button:hover { color: var(--ink); }
</style>
